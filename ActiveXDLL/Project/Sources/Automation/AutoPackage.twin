Private Module AutoPackage

Sub prep_for_package()
    Dim inProjFolderPath As String
    Dim outProjFilePath As String
    Dim exePath As String
        
    exePath = BuildPath(GetSpecialFolder(sfDocuments), "GitHub\tbImportExport\Build\ImpExp.exe")
    outProjFilePath = BuildPath(GetSpecialFolder(sfDocuments), "GitHub\tbRegExp\Package\tbRegExp.twinproj")
    inProjFolderPath = BuildPath(GetSpecialFolder(sfDocuments), "GitHub\tbRegExp\Package\Project")
        
    Dim outSourcesPath As String
    outSourcesPath = BuildPath(inProjFolderPath, "Sources")
        
    Dim c As New Collection
    c.Add ".\Project\Sources\RegExp.twin"
    c.Add ".\Project\Sources\StaticRegEx.twin"
        
    Dim p As String
    Dim s() As String
    Dim o() As String
    Dim i As Long, j As Long

    For Each p In c.Items
        ReDim o(0 To 1000000)
        o(0) = "' =========================================================================="
        o(1) = "' This file was automatically generated from the ActiveX DLL version source."
        o(2) = "' COM machinery stripped out for twinBASIC package."
        o(3) = "' =========================================================================="
        j = 3
        s = TextFileToArray(p)
        For i = LBound(s) To UBound(s)
            If Trim(s(i)) Like "[[]COMCreatable*[]]" Then GoTo skip
            If Trim(s(i)) Like "[[]ClassId*[]]" Then GoTo skip
            If Trim(s(i)) Like "[[]InterfaceId*[]]" Then GoTo skip
            j = j + 1
            o(j) = s(i)
            skip:
        Next
        ReDim Preserve o(0 To j)
        ArrayToTextFile o, BuildPath(outSourcesPath, GetFileName(p))
    Next p

    ' Modify version to match version from this project
    Dim txt As String
    Dim fp As String
    Dim d As Dictionary

    fp = BuildPath(inProjFolderPath, "Settings")
    txt = TextFileToString(fp)
        
    Set d = LibJSON.Parse(txt).Value
    d("project.versionMajor") = App.Major
    d("project.versionMinor") = App.Minor
    d("project.versionBuild") = App.Build
    d("project.versionRevision") = App.Revision
        
    txt = LibJSON.Serialize(d, indentspaces:=8)
    StringToTextFile txt, BuildPath(inProjFolderPath, "Settings")

    ' Copy/modify readme file - remove hyperlinks as they can cause IDE issues if clicked
    Dim readMePath As String
    readMePath = BuildPath(GetSpecialFolder(sfDocuments), "GitHub\tbRegExp\README.md")
    txt = TextFileToString(readMePath)
    txt = VBA.Replace$(txt, "[twinBASIC](https://twinbasic.com)", "twinBASIC")
    txt = VBA.Replace$(txt, "[Tests](https://github.com/GCuser99/tbRegExp/tree/main/ActiveXDLL/Sources/Tests) folder", "**Tests** folder")
    txt = VBA.Replace$(txt, "[Verification](#verification)", "**Verification** section below")
    StringToTextFile txt, BuildPath(inProjFolderPath, "README.md")
        
    ' Process the CHANGELOG.md - add latest changes in reverse chronological order
    txt = "# Change Log"
    txt = txt & vbCrLf & vbCrLf & "[v1.1.0.0, 29 July 2026]"
    txt = txt & vbCrLf & vbCrLf & " - Prefixed SpecialFolderConst enums so they don't clutter Intellisense"
    txt = txt & vbCrLf & " - Prefixed FileAttribute enums so they don't clutter Intellisense"
    txt = txt & vbCrLf & vbCrLf & "[v1.0.1.0, 28 July 2026]"
    txt = txt & vbCrLf & vbCrLf & " - Added automation code for building Package and SFDI twinproj files"
    txt = txt & vbCrLf & vbCrLf & "[v1.0.0.0, 27 July 2026]"
    txt = txt & vbCrLf & vbCrLf & " - Initial publication"
    StringToTextFile txt, BuildPath(inProjFolderPath, "CHANGELOG.md")

    ' Copy license file over
    Dim inLicensePath As String, outLicensePath As String
    inLicensePath = BuildPath(GetSpecialFolder(sfDocuments), "GitHub\tbRegExp\LICENSE")
    outLicensePath = BuildPath(inProjFolderPath, "LICENSE.md")
    CopyFile inLicensePath, outLicensePath
            
    DeleteFile outProjFilePath, ignoreMissing:=True
        
    ' Build the .twinproj file - requires ImpExp console app (https://github.com/GCuser99/tbImportExport)

    ' Run pack
    Shell "cmd.exe /k """"" & exePath & """ pack """ & inProjFolderPath & """ """ & outProjFilePath & """""", vbNormalFocus
    'Shell """" & exePath & """ pack """ & inProjFolderPath & """ """ & outProjFilePath & """", vbNormalFocus
End Sub
    
    Sub UnpackTwinProj()
        ' Requires ImpExp console app (https://github.com/GCuser99/tbImportExport)
        ' Note: Save this project first, then run this procedure
        Dim exePath As String
        Dim inProjFilePath As String
        Dim outProjFolderPath As String
        
        exePath = BuildPath(GetSpecialFolder(sfDocuments), "GitHub\tbImportExport\Build\ImpExp.exe")
        inProjFilePath = BuildPath(GetSpecialFolder(sfDocuments), "GitHub\tbRegExp\Package\tbRegExp.twinproj")
        outProjFolderPath = BuildPath(GetSpecialFolder(sfDocuments), "GitHub\tbRegExp\Package\Project")
        
        DeleteFolder outProjFolderPath, ignoreMissing:=True
        
        ' Run unpack
        Shell "cmd.exe /k """"" & exePath & """ unpack """ & inProjFilePath & """ """ & outProjFolderPath & """""", vbNormalFocus
        'Shell """" & exePath & """ unpack """ & inProjFilePath & """ """ & outProjFolderPath & """", vbNormalFocus
    End Sub
    
End Module