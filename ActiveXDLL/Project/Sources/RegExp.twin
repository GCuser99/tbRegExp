' ==========================================================================
' WRAPPER — RegExp / Match / MatchCollection / SubMatches (+ modRegexShared)
' Drop-in replacement for VBScript.RegExp. Engine lives in StaticRegex.twin.
'
' Lazy / shared-empty SubMatches. Match doesn't allocate a
'   SubMatches + Collection per match; group-less matches share one empty
'   instance (modRegexShared.EmptySubMatches); grouped matches build via
'   Friend AddSubMatch. Took group-less Execute from ~5s to ~90ms (~55x).
'
' Array-backed SubMatches (mVals/mKeys, not a Collection); the
'   enumeration Collection is built lazily for For Each only.
'
' Uses Internal_ prefix for Friend procedures; tB leaks Friend across the package boundary
' ==========================================================================
[COMCreatable(True)]
[ClassId("BCEDB982-44EB-4F0C-B6E2-EFE17FDFB911")]
[InterfaceId("BCEDB982-44EB-4F0C-B6E2-31FEE6287F4D")]
[PredeclaredId(False)]
[Hidden(False)]
[Description("This class exposes a drop-in replacement for VBSript's regular expressions object model.")]
Public Class RegExp
    Option Explicit
    ' ==========================================================================
    ' RegExp
    '
    ' A drop-in replacement for VBSript's regular expressions object model 
    ' by wrapping sihlfall's excellent vba-regex (https://github.com/sihlfall/vba-regex)
    '
    ' The dependency for this class is the StaticRegex module. For how to obtain the 
    ' latest copy, please see following link:
    ' https://github.com/sihlfall/vba-regex/tree/master/aio
    '
    ' Contact Info: https://github.com/GCUser99
    ' ==========================================================================
    ' MIT License
    '
    ' Copyright (c) 2025-2026, GCUser99
    '
    ' Permission is hereby granted, free of charge, to any person obtaining a copy
    ' of this software and associated documentation files (the "Software"), to deal
    ' in the Software without restriction, including without limitation the rights
    ' to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
    ' copies of the Software, and to permit persons to whom the Software is
    ' furnished to do so, subject to the following conditions:
    '
    ' The above copyright notice and this permission notice shall be included in all
    ' copies or substantial portions of the Software.
    '
    ' THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    ' IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    ' FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    ' AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    ' LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
    ' OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
    ' SOFTWARE.
    ' ========================================================================== 

    Private mGlobal As Boolean
    Private mMultiLine As Boolean
    Private mIgnoreCase As Boolean
    Private mPattern As String
    Private mDotAll As Boolean
    ' IsValid/LastError: compile state
    Private mCompileAttempted As Boolean
    Private mIsValid As Boolean
    Private mLastError As String
    Private mLastErrNumber As Long

    Private regex As StaticRegex.RegexTy
    
    [Description("Sets or Gets the options in use: g-global; m-multiline; i-ignore case; s-dot all. Example: 'gm' sets Global and MultiLine to 'True', IgnoreCase and DotAll to 'False'.")]
    Public Property Let Flags(ByVal pFlags As String)
        ' Note that if a flag indicator is not present in the string, then it is set to False
        ' Setting Flags value to vbNullString effectively sets all flags to False (default state)
        pFlags = LCase(pFlags)
        mGlobal = CBool(InStr(pFlags, "g"))
        mMultiLine = CBool(InStr(pFlags, "m"))
        IgnoreCase = CBool(InStr(pFlags, "i")) ' assign via the property (not mIgnoreCase) so its recompile-on-change side effect fires
        mDotAll = CBool(InStr(pFlags, "s"))
    End Property
    Public Property Get Flags() As String
        If mGlobal Then Flags = Flags & "g"
        If mMultiLine Then Flags = Flags & "m"
        If mIgnoreCase Then Flags = Flags & "i"
        If mDotAll Then Flags = Flags & "s"
    End Property
    
    [Description("If 'True', all matches will be returned. If 'False', only the first match will be returned. Defaults to 'False'")]
    Public Property Let Global(ByVal pGlobal As Boolean)
        mGlobal = pGlobal
    End Property
    Public Property Get Global() As Boolean
        Global = mGlobal
    End Property
    
    [Description("If 'True', '^' pattern will match the beginning of a line after a new line character and '$' will match the end of a line before a new line character. If 'False' (default), '^' will match the beginning of the entire string and '$' will match the end of the entire string.")]
    Public Property Let MultiLine(ByVal pMultiLine As Boolean)
        mMultiLine = pMultiLine
    End Property
    Public Property Get MultiLine() As Boolean
        MultiLine = mMultiLine
    End Property
    
    [Description("If 'True', '.' pattern will match across new line charactors. Defaults to 'False'")]
    Public Property Let DotAll(ByVal pDotAll As Boolean)
        mDotAll = pDotAll
    End Property
    Public Property Get DotAll() As Boolean
        DotAll = mDotAll
    End Property
    
    [Description("If 'True', matches will be case-insensitive. If 'False', matches will be case-sensitive. Defaults to 'False'")]
    Public Property Let IgnoreCase(ByVal pIgnoreCase As Boolean)
        If pIgnoreCase <> mIgnoreCase Then
            mIgnoreCase = pIgnoreCase
            mCompileAttempted = False
        End If
    End Property
    Public Property Get IgnoreCase() As Boolean
        IgnoreCase = mIgnoreCase
    End Property
    
    [Description("The regular expression pattern.")]
    Public Property Let Pattern(ByVal pPattern As String)
        If pPattern <> mPattern Then
            mPattern = pPattern
            mCompileAttempted = False
        End If
    End Property
    Public Property Get Pattern() As String
        Pattern = mPattern
    End Property
    
    [Description("Returns a MatchCollection. Uses the Pattern property to search the sourceString.")]
    Public Function Execute(ByVal sourceString As String) As MatchCollection
        Dim matcherState As StaticRegex.MatcherStateTy
        Dim oMatches As MatchCollection
        Dim oMatch As Match
        Dim i As Long
        Dim matchStart As Long, matchLength As Long
        
        EnsureCompiled
        If Not mIsValid Then Err.Raise mLastErrNumber, "RegExp", mLastError

        StaticRegex.InitializeMatcherState matcherState, Not mGlobal, mMultiLine, mDotAll
    
        Dim colNames As New Collection
        Dim colEntryPoints As New Collection
        
        GetNamedCapturesInfo colNames, colEntryPoints
        
        Set oMatches = New MatchCollection

        Do While StaticRegex.MatchNext(matcherState, regex, sourceString)

            With matcherState.captures
                Dim mValue As String, mFirst As Long, mLen As Long
                matchStart = .entireMatch.start
                matchLength = .entireMatch.Length
                If matchStart > 0 Then
                    mValue = Mid$(sourceString, matchStart, matchLength)
                    mFirst = matchStart - 1          ' zero-based, matches VBScript_RegExp_55
                    mLen = matchLength
                Else
                    mValue = vbNullString
                    mFirst = 0
                    mLen = 0
                End If

                Dim subVals() As String, subKeys() As String
                Dim n As Long
                n = .nNumberedCaptures

                If n > 0 Then
                    ReDim subVals(0 To n - 1)
                    ReDim subKeys(0 To n - 1)       ' vbNullString by default = unnamed

                    ' name the slots (single pass over named captures)
                    If .nNamedCaptures > 0 Then
                        Dim referenced As Long
                        For i = 1 To colNames.Count
                            referenced = .namedCaptures(colEntryPoints(i))
                            If referenced <> -1 Then subKeys(referenced - 1) = colNames(i)
                        Next i
                    End If

                    ' fill the values (single pass over numbered captures)
                    For i = 0 To n - 1
                        matchStart = .numberedCaptures(i).start
                        matchLength = .numberedCaptures(i).Length
                        If matchStart > 0 Then
                            subVals(i) = Mid$(sourceString, matchStart, matchLength)
                        Else
                            subVals(i) = vbNullString
                        End If
                    Next i
                End If

                Set oMatch = New Match
                oMatch.Internal_Init mValue, mFirst, mLen, subVals, subKeys, n
                oMatches.Internal_Add oMatch
            End With
        Loop
        Set Execute = oMatches
    End Function
    
    [Description("Returns 'True' if Pattern finds a match in sourceString, otherwise returns 'False'.")]
    Public Function Test(ByVal sourceString As String) As Boolean
        EnsureCompiled
        If Not mIsValid Then Err.Raise mLastErrNumber, "RegExp", mLastError
        Test = StaticRegex.Test(regex, sourceString, mMultiLine, mDotAll)
    End Function
    
    [Description("Replaces matches with replaceString and returns the String with replacements made.")]
    Public Function Replace(ByVal sourceString As String, ByVal replaceString As String) As String
        EnsureCompiled
        If Not mIsValid Then Err.Raise mLastErrNumber, "RegExp", mLastError
        Replace = StaticRegex.ReplaceByRegEx(regex, replaceString, sourceString, Not mGlobal, mMultiLine, mDotAll)
    End Function
    
    [Description("Splits an input string into an array of substrings at the positions defined by a regular expression match. Needs Global Property set to 'True'.")]
    Public Function Split(ByVal sourceString As String) As Collection
        EnsureCompiled
        If Not mIsValid Then Err.Raise mLastErrNumber, "RegExp", mLastError
        Set Split = StaticRegex.SplitByRegex(regex, sourceString, Not mGlobal, mMultiLine, mDotAll)
    End Function
    
    [Description("Returns True if the current Pattern compiles successfully; False if it is invalid. Does not raise.")]
    Public Property Get IsValid() As Boolean
        EnsureCompiled
        IsValid = mIsValid
    End Property

    [Description("Returns the compile error message for the current Pattern, or an empty string if the Pattern is valid.")]
    Public Property Get LastError() As String
        EnsureCompiled
        LastError = mLastError
    End Property

    [Description("Returns the compile error number for the current Pattern, or 0 if the Pattern is valid.")]
    Public Property Get LastErrorNumber() As Long
        EnsureCompiled
        LastErrorNumber = mLastErrNumber
    End Property
    
    ' Compiles the current Pattern once per Pattern/IgnoreCase change, trapping any engine
    ' error so validity can be queried without raising. Never raises. IgnoreCase is the only
    ' compile-time flag; MultiLine/DotAll/Global are applied at match time, so recompiling
    ' only on Pattern/IgnoreCase change is correct.
    Private Sub EnsureCompiled()
        If mCompileAttempted Then Exit Sub
        mCompileAttempted = True
        mLastErrNumber = 0
        mLastError = vbNullString

        On Error Resume Next
        StaticRegex.InitializeRegex regex, mPattern, mIgnoreCase
        mLastErrNumber = Err.Number
        If mLastErrNumber = 0 Then
            mLastError = vbNullString
        Else
            mLastError = ErrText(mLastErrNumber, Err.Description)
        End If
        On Error GoTo 0
        mIsValid = (mLastErrNumber = 0)
    End Sub
    
    Private Sub GetNamedCapturesInfo(ByRef colNames As Collection, ByRef colEntryPoints As Collection)
        Dim identifierMapEnd As Long
        Dim currentEntry As Long
        Dim identifier As String
        
        identifierMapEnd = BYTECODE_IDENTIFIER_MAP_BEGIN + _
            BYTECODE_IDENTIFIER_MAP_ENTRY_SIZE * regex.bytecode(BYTECODE_IDX_N_IDENTIFIERS)
        currentEntry = BYTECODE_IDENTIFIER_MAP_BEGIN

        Do While currentEntry < identifierMapEnd
            identifier = Mid$( _
                regex.pattern, _
                regex.bytecode(currentEntry + BYTECODE_IDENTIFIER_MAP_ENTRY_START_IN_PATTERN), _
                regex.bytecode(currentEntry + BYTECODE_IDENTIFIER_MAP_ENTRY_LENGTH_IN_PATTERN) _
            )
            colNames.Add(identifier)
            colEntryPoints.Add(regex.bytecode(currentEntry + BYTECODE_IDENTIFIER_MAP_ENTRY_ID))
            currentEntry = currentEntry + BYTECODE_IDENTIFIER_MAP_ENTRY_SIZE
        Loop
    End Sub
    
    Private Sub Class_Initialize()
        mGlobal = False 'StaticRegex defaults to True
        mMultiLine = False
        mIgnoreCase = False
        mDotAll = False
    End Sub
    
    ' Maps an engine REGEX_ERR_* number to a human-readable description.
    ' Offsets mirror StaticRegex's error enum (REGEX_ERR = vbObjectError + 3000).
    Private Function DescribeRegexError(ByVal errNum As Long) As String
        Const BASE As Long = vbObjectError + 3000
        Select Case errNum - BASE
        Case 1   ' INVALID_REGEXP_ESCAPE
            DescribeRegexError = "Invalid escape sequence in the pattern (an unrecognized '\' escape)."
        Case 2   ' INVALID_ESCAPE
            DescribeRegexError = "Invalid escape sequence."
        Case 3   ' INVALID_RANGE
            DescribeRegexError = "Invalid character range in a '[...]' class (e.g. '[z-a]', where the start is greater than the end)."
        Case 4   ' UNTERMINATED_CHARCLASS
            DescribeRegexError = "Unterminated character class: a '[' without a matching ']'."
        Case 6   ' INVALID_REGEXP_GROUP
            DescribeRegexError = "Invalid group construct: a malformed '(?...)' group."
        Case 7   ' INVALID_REGEXP_CHARACTER
            DescribeRegexError = "Invalid character in the pattern."
        Case 8   ' INVALID_QUANTIFIER
            DescribeRegexError = "Invalid quantifier: a malformed '{n,m}' count (e.g. '{2,1}', or a number too large)."
        Case 9   ' UNEXPECTED_END_OF_PATTERN
            DescribeRegexError = "Unexpected end of pattern: an unclosed group — a '(' without a matching ')'."
        Case 10  ' UNEXPECTED_REGEXP_TOKEN
            DescribeRegexError = "Unexpected token in the pattern."
        Case 11  ' UNEXPECTED_CLOSING_PAREN
            DescribeRegexError = "Unmatched ')': a closing parenthesis with no matching '('."
        Case 12  ' INVALID_QUANTIFIER_NO_ATOM
            DescribeRegexError = "Quantifier with nothing to repeat (e.g. a leading '*', '+', or '?')."
        Case 13  ' INVALID_IDENTIFIER
            DescribeRegexError = "Invalid capture-group name. Names must start with a letter or underscore, then contain only letters, digits, or underscores (and must not start with a digit)."
        Case 14  ' INVALID_MODIFIER
            DescribeRegexError = "Invalid inline modifier: a malformed or repeated '(?i)'/'(?m)'/'(?s)' flag group."
        Case 20  ' INTERNAL_LOGIC_ERR
            DescribeRegexError = "Internal engine error (this should not happen — please report the pattern)."
        Case 30  ' INVALID_FLAG_ERR
            DescribeRegexError = "Invalid flag."
        Case 31  ' INVALID_REPLACEMENT_STRING
            DescribeRegexError = "Invalid replacement string (a malformed '$' reference)."
        Case 50  ' INVALID_INPUT
            DescribeRegexError = "Invalid input."
        Case Else
            ' not one of ours - pass through whatever the runtime gave us, or a generic line
            DescribeRegexError = vbNullString
        End Select
    End Function

    Private Function ErrText(ByVal errNum As Long, ByVal fallback As String) As String
        Dim s As String
        s = DescribeRegexError(errNum)
        If LenB(s) = 0 Then
            If LenB(fallback) > 0 Then ErrText = fallback Else ErrText = "Invalid regular expression pattern."
        Else
            ErrText = s
        End If
    End Function

End Class

[COMCreatable(False)]
[PredeclaredId(False)]
[InterfaceId("BCEDB982-44EB-4F0C-B6E2-BDEC4D046CEF")]
[Hidden(False)]
[Description("This class represents the results from a single regular expression match.")]
Public Class Match
    Option Explicit
    
    Private oSubMatches As SubMatches
    Private mValue As String
    Private mFirstIndex As Long
    Private mLength As Long

    [Description("Returns the SubMatches collection of submatch (Group) strings.")]
    Public Property Get SubMatches() As SubMatches
        ' group-less matches share one empty instance (no per-match allocation)
        If oSubMatches Is Nothing Then
            Set SubMatches = modRegexShared.EmptySubMatches
        Else
            Set SubMatches = oSubMatches
        End If
    End Property

    [Description("Returns the entire matched string")]
    [DefaultMember]
    Public Property Get Value() As String
        Value = mValue
    End Property

    [Description("Returns the character index position associated with the start of the match string. Note that the index is zero-based.")]
    Public Property Get FirstIndex() As Long
        FirstIndex = mFirstIndex
    End Property

    [Description("Returns the character length of the match string.")]
    Public Property Get Length() As Long
        Length = mLength
    End Property

    ' Internal_ prefix: package-internal construction seam. tB leaks Friend across the
    ' package boundary, so this flags it as not-for-consumers. Single channel for building
    ' a Match: scalars in one shot, submatches moved in as arrays. subCount = 0 keeps the
    ' shared-empty SubMatches (group-less fast path).
    Friend Sub Internal_Init(ByVal matchValue As String, ByVal firstIndex As Long, ByVal length As Long, _
                             ByRef subVals() As String, ByRef subKeys() As String, ByVal subCount As Long)
        mValue = matchValue
        mFirstIndex = firstIndex
        mLength = length
        If subCount > 0 Then
            Set oSubMatches = New SubMatches
            oSubMatches.Internal_SetData subVals, subKeys, subCount
        End If
    End Sub
    
    Private Sub Class_Terminate()
        Set oSubMatches = Nothing
    End Sub

End Class

[COMCreatable(False)]
[PredeclaredId(False)]
[InterfaceId("BCEDB982-44EB-4F0C-B6E2-FF2410FF86B2")]
[Hidden(False)]
[Description("This class represents a collection of match objects.")]
Public Class MatchCollection
    Option Explicit

    Private colMatches As Collection

    Friend Sub Internal_Add(obj As Match)
        colMatches.Add obj
    End Sub
    
    [Description("Returns the number of Match objects found in the source string.")]
    Public Property Get Count() As Long
       Count = colMatches.Count
    End Property
    
    [Description("Returns the Match object associated with the provided index")]
    [DefaultMember]
    Public Property Get Item(ByVal pItemIndex As Variant) As Match
        'VBS is zero-based, but Collection is 1-based
        If pItemIndex + 1 >= 1 And pItemIndex + 1 <= colMatches.Count Then
            Set Item = colMatches.Item(pItemIndex + 1)
        Else
            Err.Raise(vbObjectError + 9, , "Requested item not found in Matches collection")
        End If
    End Property

    [Hidden(True)]
    [Enumerator]
    Public Function NewEnum() As IUnknown
        Set NewEnum = colMatches.[_NewEnum]
    End Function

    Private Sub Class_Terminate()
        Set colMatches = Nothing
    End Sub

    Private Sub Class_Initialize()
        Set colMatches = New Collection
    End Sub

End Class

[COMCreatable(False)]
[PredeclaredId(False)]
[InterfaceId("BCEDB982-44EB-4F0C-B6E2-1537F3762923")]
[Hidden(False)]
[Description("This class provides the means to access SubMatch (Group) values.")]
Public Class SubMatches
    Option Explicit

    ' Array-backed storage; Collection built lazily only for For Each
    Private mVals() As String
    Private mKeys() As String       ' parallel to mVals; vbNullString for unnamed groups
    Private mCount As Long
    Private mCap As Long
    Private oEnumColl As Collection ' lazy, For Each only

    ' Internal_ prefix: package-internal seam (tB leaks Friend across the package boundary).
    ' Bulk-assign the backing arrays in one operation instead of N Add calls.
    Friend Sub Internal_SetData(ByRef vals() As String, ByRef keys() As String, ByVal count As Long)
        mVals = vals            ' single bulk array assignment
        mKeys = keys
        mCount = count
        mCap = count            ' arrays are sized exactly; growth path unused here
        Set oEnumColl = Nothing
    End Sub

    [Description("Returns the number of SubMatch objects found in the source string.")]
    Public Property Get Count() As Long
        Count = mCount
    End Property

    [Description("Returns the SubMatch string associated with the provided index. Named groups are allowed.")]
    [DefaultMember]
    Public Property Get Item(ByVal pItemIndex As Variant) As String
        If Not IsNumeric(pItemIndex) Then
            'lookup by name; not-found or empty-value both yield vbNullString (prior behavior)
            Dim i As Long
            For i = 0 To mCount - 1
                If mKeys(i) = pItemIndex Then
                    Item = mVals(i)
                    Exit Property
                End If
            Next i
        Else
            'VBS is zero-based
            If pItemIndex >= 0 And pItemIndex < mCount Then
                Item = mVals(pItemIndex)
            Else
                Err.Raise(vbObjectError + 9, , "Requested item not found in SubMatches collection")
            End If
        End If
    End Property

    [Hidden(True)]
    [Enumerator]
    Public Function NewEnum() As IUnknown
        ' Build the enumeration Collection on demand (SubMatches are tiny); index/key
        ' access never gets here, so grouped matches pay no Collection cost during Execute
        If oEnumColl Is Nothing Then
            Set oEnumColl = New Collection
            Dim i As Long
            For i = 0 To mCount - 1
                oEnumColl.Add mVals(i)
            Next i
        End If
        Set NewEnum = oEnumColl.[_NewEnum]
    End Function

    Private Sub Class_Terminate()
        Set oEnumColl = Nothing
    End Sub
End Class

Private Module modRegexShared
    Option Explicit
    ' One read-only, always-empty SubMatches shared by every match of a group-less
    ' pattern, so those matches don't each allocate a SubMatches + Collection.
    ' Safe to share: it is never Added to (Add is Friend and never called on it),
    ' so it stays empty and immutable — observationally identical to a fresh empty.

    Private mEmpty As SubMatches

    Public Function EmptySubMatches() As SubMatches
        If mEmpty Is Nothing Then Set mEmpty = New SubMatches
        Set EmptySubMatches = mEmpty
    End Function
End Module