Module modBench
    Option Explicit
    ' ==========================================================================
    ' modBench - timed benchmark harness for the RegExp replacement class
    '
    ' Two ways to run, both produce the same report:
    '   * IDE:  execute RunBench (F5). Table appears in the Immediate pane AND
    '           is written to %TEMP%\regexp_bench_<ts>.txt (+ a .csv).
    '   * EXE:  wire a form button to RunSuite() (runs parity + bench) and show
    '           the returned path. Debug.Print is stripped in compiled builds,
    '           so the .txt/.csv files are how you read results there.
    '
    ' Native-target notes:
    '   * gSink defeats dead-code elimination - every result is consumed.
    '   * Each case is warmed (forces lazy table init), timed over TRIALS trials;
    '     the MIN is kept. Iteration counts auto-calibrate to run >= MIN_TIME.
    '   * The COM column is late-bound VBScript.RegExp - a reference point that
    '     carries IDispatch overhead our early-bound calls don't. The number
    '     that governs our work is ours-vs-ours across passes (apples to apples).
    '
    ' Requires modReport.twin. Do NOT add the "Microsoft VBScript Regular
    ' Expressions 5.5" reference; we CreateObject it late-bound (and the names
    ' would collide with our own RegExp/Match/MatchCollection/SubMatches).
    ' ==========================================================================

    Private Declare PtrSafe Function QueryPerformanceCounter Lib "kernel32" (lpPerformanceCount As LongLong) As BOOL
    Private Declare PtrSafe Function QueryPerformanceFrequency Lib "kernel32" (lpFrequency As LongLong) As BOOL
    Private Enum BOOL
        CFALSE
        CTRUE
        API_TRUE = 1
        API_FALSE = 0
        APITRUE = 1
        APIFALSE = 0
    End Enum

    ' --- tuning knobs -------------------------------------------------------
    Private Const MIN_TIME As Double = 0.15      ' min seconds a timed run must take
    Private Const TRIALS As Long = 5             ' timed trials per case (min is kept)
    Private Const MAX_ITERS As Long = 20000000   ' safety cap on iteration count
    Private Const WARMUP As Long = 3             ' warm-up calls before timing
    Private Const LARGE_TARGET As Long = 200000  ' char length of the "large" corpus
    ' ------------------------------------------------------------------------

    Public gSink As LongLong                     ' anti-DCE accumulator
    Private mFreq As LongLong                     ' QPC frequency (ticks/sec)

    Private Enum BenchOp
        opTest
        opExecute
        opReplace
        opSplit
        opExecuteFull      '>>> DIAG: full Execute, read .Count only (eager build still happens)
        opExecuteRaw       '>>> DIAG: engine-only MatchNext loop, no wrapper objects
    End Enum

    Private Type BenchCase
        Name As String
        Pattern As String
        Flags As String          ' any of g m i s (parsed by RegExp.Flags)
        Op As BenchOp
        Input As String
        ReplaceWith As String     ' used only by opReplace
        Comparable As Boolean     ' can we run the same thing on VBScript.RegExp?
    End Type

    Private Type Measure
        nsPerOp As Double
        iters As Long
        ok As Boolean
    End Type
    
    ' Cached compiled regex for the engine-only path
    Private mDiagRegex As StaticRegex.RegexTy
    Private mDiagKey As String

    ' ======================================================================
    ' Entry points
    ' ======================================================================

    ' IDE entry: run the benchmark on its own.
    Public Sub RunBench()
        modReport.Reset
        BenchCore
        Dim p As String
        p = modReport.Flush("regexp_bench")
        Debug.Print "report written: " & p
    End Sub

    ' EXE entry: parity + benchmark into one report. Returns the .txt path
    ' (empty string if the file couldn't be written). Call this from a form button.
    Public Function RunSuite() As String
        modReport.Reset
        modParity.ParityCore
        modReport.Emit vbNullString
        modReport.Emit String$(96, "=")
        BenchCore
        RunSuite = modReport.Flush("regexp_suite")
        Debug.Print "report written: " & RunSuite
    End Function

    ' ======================================================================
    ' Benchmark body (emits only - no reset/flush, so it composes)
    ' ======================================================================
    Private Sub BenchCore()
        If QueryPerformanceFrequency(mFreq) = 0 Then
            modReport.Emit "QueryPerformanceFrequency failed - cannot time."
            Exit Sub
        End If

        Dim cases() As BenchCase
        cases = BuildCases()

        Dim oCom As Object
        On Error Resume Next
        Set oCom = CreateObject("VBScript.RegExp")
        On Error GoTo 0
        Dim haveCom As Boolean
        haveCom = Not (oCom Is Nothing)

        PrintHeader haveCom

        Dim csv As String
        csv = "case,op,flags,input_len,ours_ns_per_op,com_ns_per_op,ratio_ours_over_com,ours_iters" & vbCrLf

        Dim i As Long
        For i = 0 To UBound(cases)
            Dim mOurs As Measure, mCom As Measure
            mOurs = MeasureOurs(cases(i))

            mCom.ok = False
            If haveCom And cases(i).Comparable Then
                mCom = MeasureCom(cases(i), oCom)
            End If

            PrintRow cases(i), mOurs, mCom
            csv = csv & CsvRow(cases(i), mOurs, mCom)
        Next i

        modReport.Emit String$(96, "-")
        modReport.Emit "sink (ignore): " & CStr(gSink)
        WriteCsv csv
    End Sub

    ' ======================================================================
    ' Measurement - OURS (early bound)
    ' ======================================================================
    Private Function MeasureOurs(ByRef c As BenchCase) As Measure
        Dim re As RegExp
        Set re = New RegExp
        re.Flags = c.Flags
        re.Pattern = c.Pattern

        Dim w As Long
        For w = 1 To WARMUP
            gSink = gSink + DoOursOp(re, c)
        Next w

        Dim iters As Long
        iters = CalibrateOurs(re, c)

        Dim best As Double, t As Long, ns As Double
        best = 1E+30
        For t = 1 To TRIALS
            ns = TimeOurs(re, c, iters)
            If ns < best Then best = ns
        Next t

        MeasureOurs.nsPerOp = best
        MeasureOurs.iters = iters
        MeasureOurs.ok = True
    End Function

    Private Function TimeOurs(ByRef re As RegExp, ByRef c As BenchCase, ByVal iters As Long) As Double
        Dim t0 As LongLong, t1 As LongLong, k As Long
        QueryPerformanceCounter t0
        For k = 1 To iters
            gSink = gSink + DoOursOp(re, c)
        Next k
        QueryPerformanceCounter t1
        TimeOurs = (CDbl(t1 - t0) * 1000000000#) / (CDbl(mFreq) * CDbl(iters))
    End Function

    Private Function CalibrateOurs(ByRef re As RegExp, ByRef c As BenchCase) As Long
        Dim iters As Long, elapsed As Double
        iters = 1
        Do
            Dim t0 As LongLong, t1 As LongLong, k As Long
            QueryPerformanceCounter t0
            For k = 1 To iters
                gSink = gSink + DoOursOp(re, c)
            Next k
            QueryPerformanceCounter t1
            elapsed = CDbl(t1 - t0) / CDbl(mFreq)
            If elapsed >= MIN_TIME Or iters >= MAX_ITERS Then Exit Do
            iters = NextIters(iters, elapsed)
        Loop
        CalibrateOurs = iters
    End Function

    ' ======================================================================
    ' Measurement - COM baseline (late bound VBScript.RegExp)
    ' ======================================================================
    Private Function MeasureCom(ByRef c As BenchCase, ByRef oCom As Object) As Measure
        On Error GoTo Fail
        SetupCom oCom, c

        Dim w As Long
        For w = 1 To WARMUP
            gSink = gSink + DoComOp(oCom, c)
        Next w

        Dim iters As Long
        iters = CalibrateCom(oCom, c)

        Dim best As Double, t As Long, ns As Double
        best = 1E+30
        For t = 1 To TRIALS
            ns = TimeCom(oCom, c, iters)
            If ns < best Then best = ns
        Next t

        MeasureCom.nsPerOp = best
        MeasureCom.iters = iters
        MeasureCom.ok = True
        Exit Function
Fail:
        MeasureCom.ok = False
    End Function

    Private Function TimeCom(ByRef oCom As Object, ByRef c As BenchCase, ByVal iters As Long) As Double
        Dim t0 As LongLong, t1 As LongLong, k As Long
        QueryPerformanceCounter t0
        For k = 1 To iters
            gSink = gSink + DoComOp(oCom, c)
        Next k
        QueryPerformanceCounter t1
        TimeCom = (CDbl(t1 - t0) * 1000000000#) / (CDbl(mFreq) * CDbl(iters))
    End Function

    Private Function CalibrateCom(ByRef oCom As Object, ByRef c As BenchCase) As Long
        Dim iters As Long, elapsed As Double
        iters = 1
        Do
            Dim t0 As LongLong, t1 As LongLong, k As Long
            QueryPerformanceCounter t0
            For k = 1 To iters
                gSink = gSink + DoComOp(oCom, c)
            Next k
            QueryPerformanceCounter t1
            elapsed = CDbl(t1 - t0) / CDbl(mFreq)
            If elapsed >= MIN_TIME Or iters >= MAX_ITERS Then Exit Do
            iters = NextIters(iters, elapsed)
        Loop
        CalibrateCom = iters
    End Function

    Private Function NextIters(ByVal iters As Long, ByVal elapsed As Double) As Long
        Dim ni As Double
        If elapsed < 0.000001 Then
            ni = CDbl(iters) * 8#
        Else
            Dim factor As Double
            factor = (MIN_TIME * 1.5) / elapsed
            If factor < 2# Then factor = 2#
            ni = CDbl(iters) * factor
        End If
        If ni > CDbl(MAX_ITERS) Then ni = CDbl(MAX_ITERS)
        NextIters = CLng(ni)
    End Function

    ' ======================================================================
    ' The operations under test (one op == one sink value)
    ' ======================================================================
    Private Function DoOursOp(ByRef re As RegExp, ByRef c As BenchCase) As Long
        Select Case c.Op
        Case opTest
            DoOursOp = IIf(re.Test(c.Input), 1, 0)
        Case opExecute
            Dim mc As MatchCollection
            Set mc = re.Execute(c.Input)
            DoOursOp = ConsumeOurs(mc)
        Case opReplace
            DoOursOp = Len(re.Replace(c.Input, c.ReplaceWith))
        Case opSplit
            Dim col As Collection
            Set col = re.Split(c.Input)
            DoOursOp = col.Count
            '>>> DIAG
            Case opExecuteFull
                DoOursOp = re.Execute(c.Input).Count
            Case opExecuteRaw
                Dim rk As String
                rk = c.Flags & "|" & c.Pattern
                If rk <> mDiagKey Then
                    StaticRegex.InitializeRegex mDiagRegex, c.Pattern, (InStr(LCase$(c.Flags), "i") > 0)
                    mDiagKey = rk
                End If
                DoOursOp = EngineLoop(mDiagRegex, c)
            '<<< DIAG            
        End Select
    End Function

    ' Consume every match Value and submatch so the wrapper's allocation and
    ' (future) lazy-value behaviour are measured on the realistic "you use the
    ' results" path - not just .Count.
    Private Function ConsumeOurs(ByRef mc As MatchCollection) As Long
        Dim acc As Long, i As Long, j As Long
        acc = mc.Count
        For i = 0 To mc.Count - 1
            Dim m As Match
            Set m = mc.Item(i)
            acc = acc + Len(m.Value)
            Dim sm As SubMatches
            Set sm = m.SubMatches
            For j = 0 To sm.Count - 1
                acc = acc + Len(sm.Item(j))
            Next j
        Next i
        ConsumeOurs = acc
    End Function

    Private Function DoComOp(ByRef oCom As Object, ByRef c As BenchCase) As Long
        Select Case c.Op
        Case opTest
            DoComOp = IIf(oCom.Test(c.Input), 1, 0)
        Case opExecute
            Dim mc As Object
            Set mc = oCom.Execute(c.Input)
            DoComOp = ConsumeCom(mc)
        Case opReplace
            DoComOp = Len(oCom.Replace(c.Input, c.ReplaceWith))
        ' opSplit: VBScript.RegExp has no Split -> never marked Comparable
        End Select
    End Function

    Private Function ConsumeCom(ByRef mc As Object) As Long
        Dim acc As Long, i As Long, j As Long
        acc = mc.Count
        For i = 0 To mc.Count - 1
            Dim m As Object
            Set m = mc.Item(i)
            acc = acc + Len(m.Value)
            Dim sm As Object
            Set sm = m.SubMatches
            For j = 0 To sm.Count - 1
                acc = acc + Len("" & sm.Item(j))
            Next j
        Next i
        ConsumeCom = acc
    End Function

    Private Sub SetupCom(ByRef oCom As Object, ByRef c As BenchCase)
        oCom.Pattern = c.Pattern
        oCom.Global = (InStr(LCase$(c.Flags), "g") > 0)
        oCom.IgnoreCase = (InStr(LCase$(c.Flags), "i") > 0)
        oCom.MultiLine = (InStr(LCase$(c.Flags), "m") > 0)
    End Sub

    ' ======================================================================
    ' Cases
    ' ======================================================================
    Private Function BuildCases() As BenchCase()
        Dim small As String, large As String, backtrack As String
        small = BaseChunk()
        large = RepeatTo(BaseChunk(), LARGE_TARGET)
        backtrack = String$(16, "a") & "!"    ' (a+)+$ fails -> heavy backtracking

        Dim c() As BenchCase
        ReDim c(0 To 11)

        c(0) = MakeCase("test_literal_short", "fox", "", opTest, small, "", True)
        c(1) = MakeCase("test_literal_miss_large", "qxzqxz", "", opTest, large, "", True)
        c(2) = MakeCase("exec_char_class", "[A-Za-z]+", "g", opExecute, large, "", True)
        c(3) = MakeCase("exec_word_token", "\w+", "g", opExecute, large, "", True)
        c(4) = MakeCase("exec_alternation", "cat|dog|bird|fish", "g", opExecute, large, "", True)
        c(5) = MakeCase("exec_date_groups", "(\d{4})-(\d{2})-(\d{2})", "g", opExecute, large, "", True)
        c(6) = MakeCase("exec_email", "[\w.]+@[\w.]+", "g", opExecute, large, "", True)
        ' named captures: exercises the per-match keymap path; COM 5.5 can't do (?<name>)
        c(7) = MakeCase("exec_named_dates", "(?<y>\d{4})-(?<m>\d{2})-(?<d>\d{2})", "g", opExecute, large, "", False)
        c(8) = MakeCase("replace_digits", "\d", "g", opReplace, large, "#", True)
        c(9) = MakeCase("replace_backref", "(\w)(\w)", "g", opReplace, large, "$2$1", True)
        ' Split: ours only (COM has no Split)
        c(10) = MakeCase("split_whitespace", "\s+", "g", opSplit, large, "", False)
        ' pure matcher stress, no wrapper allocation
        c(11) = MakeCase("test_backtracking", "(a+)+$", "", opTest, backtrack, "", True)

        BuildCases = c
    End Function

    Private Function MakeCase(ByVal nm As String, ByVal pat As String, ByVal fl As String, _
                              ByVal op As BenchOp, ByRef inp As String, ByVal rep As String, _
                              ByVal cmp As Boolean) As BenchCase
        MakeCase.Name = nm
        MakeCase.Pattern = pat
        MakeCase.Flags = fl
        MakeCase.Op = op
        MakeCase.Input = inp
        MakeCase.ReplaceWith = rep
        MakeCase.Comparable = cmp
    End Function

    Private Function BaseChunk() As String
        BaseChunk = "The quick brown fox 2021-06-09 jumps over user99@example.com " & _
                    "the lazy dog. Animals: cat dog bird fish cat. " & _
                    "Order #12345 shipped 2026-07-16 to a1@b2.co." & vbCrLf
    End Function

    Private Function RepeatTo(ByVal s As String, ByVal targetLen As Long) As String
        If Len(s) = 0 Then Exit Function
        Dim r As String
        r = s
        Do While Len(r) < targetLen
            r = r & r
        Loop
        RepeatTo = Left$(r, targetLen)
    End Function

    ' ======================================================================
    ' Reporting (all via modReport.Emit -> IDE pane + .txt buffer)
    ' ======================================================================
    Private Sub PrintHeader(ByVal haveCom As Boolean)
        modReport.Emit String$(96, "=")
        modReport.Emit "RegExp benchmark   MIN_TIME=" & CStr(MIN_TIME) & "s  TRIALS=" & CStr(TRIALS) & _
                       "  large=" & CStr(LARGE_TARGET) & " chars"
        If Not haveCom Then modReport.Emit "(VBScript.RegExp unavailable - showing ours only)"
        modReport.Emit String$(96, "-")
        modReport.Emit PadR("case", 26) & PadR("op", 9) & PadL("in_len", 8) & _
                       PadL("ours ns/op", 14) & PadL("com ns/op", 14) & PadL("ours/com", 11)
        modReport.Emit String$(96, "-")
    End Sub

    Private Sub PrintRow(ByRef c As BenchCase, ByRef mo As Measure, ByRef mc As Measure)
        Dim comStr As String, ratioStr As String
        If mc.ok Then
            comStr = Format$(mc.nsPerOp, "#,##0")
            If mc.nsPerOp > 0 Then ratioStr = Format$(mo.nsPerOp / mc.nsPerOp, "0.00") & "x" Else ratioStr = "-"
        Else
            comStr = "-"
            ratioStr = "-"
        End If
        modReport.Emit PadR(c.Name, 26) & PadR(OpName(c.Op), 9) & PadL(CStr(Len(c.Input)), 8) & _
                       PadL(Format$(mo.nsPerOp, "#,##0"), 14) & PadL(comStr, 14) & PadL(ratioStr, 11)
    End Sub

    Private Function CsvRow(ByRef c As BenchCase, ByRef mo As Measure, ByRef mc As Measure) As String
        Dim comVal As String, ratio As String
        If mc.ok Then
            comVal = Format$(mc.nsPerOp, "0.0")
            If mc.nsPerOp > 0 Then ratio = Format$(mo.nsPerOp / mc.nsPerOp, "0.000") Else ratio = ""
        Else
            comVal = "": ratio = ""
        End If
        CsvRow = c.Name & "," & OpName(c.Op) & "," & c.Flags & "," & CStr(Len(c.Input)) & "," & _
                 Format$(mo.nsPerOp, "0.0") & "," & comVal & "," & ratio & "," & CStr(mo.iters) & vbCrLf
    End Function

    Private Sub WriteCsv(ByRef csv As String)
        Dim path As String, ff As Integer
        'path = Environ$("TEMP") & "\regexp_bench_" & Format$(Now, "yyyymmdd_hhnnss") & ".csv"
        path = Environ$("USERPROFILE") & "\Documents\GitHub\tbRegExp\Tests" & "\regexp_bench_" & Format$(Now, "yyyymmdd_hhnnss") & ".csv"
        On Error GoTo Fail
        ff = FreeFile
        Open path For Output As #ff
        Print #ff, csv ;
        Close #ff
        modReport.Emit "CSV written: " & path
        Exit Sub
Fail:
        modReport.Emit "CSV write failed (" & Err.Description & ") - table above is still valid."
    End Sub

    Private Function OpName(ByVal op As BenchOp) As String
        Select Case op
        Case opTest:    OpName = "Test"
        Case opExecute: OpName = "Execute"
        Case opReplace: OpName = "Replace"
        Case opSplit:   OpName = "Split"
        End Select
    End Function

    Private Function PadR(ByVal s As String, ByVal n As Long) As String
        If Len(s) >= n Then PadR = Left$(s, n) Else PadR = s & Space$(n - Len(s))
    End Function

    Private Function PadL(ByVal s As String, ByVal n As Long) As String
        If Len(s) >= n Then PadL = Right$(s, n) Else PadL = Space$(n - Len(s)) & s
    End Function
    
    '>>> DIAG: engine-only match loop — mirrors Execute's engine work, skips all wrapper build
    Private Function EngineLoop(ByRef rgx As StaticRegex.RegexTy, ByRef c As BenchCase) As Long
        Dim ms As StaticRegex.MatcherStateTy, i As Long, acc As Long
        StaticRegex.InitializeMatcherState ms, _
            (InStr(LCase$(c.Flags), "g") = 0), _
            (InStr(LCase$(c.Flags), "m") > 0), _
            (InStr(LCase$(c.Flags), "s") > 0)
        Do While StaticRegex.MatchNext(ms, rgx, c.Input)
            acc = acc + ms.captures.entireMatch.Length
            For i = 0 To ms.captures.nNumberedCaptures - 1
                acc = acc + ms.captures.numberedCaptures(i).Length
            Next i
        Loop
        EngineLoop = acc
    End Function

    ' IDE entry, or wire to a form button (returns the .txt path).
    Public Function RunDiagnostic() As String
        modReport.Reset
        If QueryPerformanceFrequency(mFreq) = 0 Then
            modReport.Emit "QueryPerformanceFrequency failed - cannot time."
        Else
            DiagCore
        End If
        RunDiagnostic = modReport.Flush("regexp_diag")
        Debug.Print "report written: " & RunDiagnostic
    End Function

    Private Sub DiagCore()
        Dim large As String
        large = RepeatTo(BaseChunk(), LARGE_TARGET)

        modReport.Emit String$(80, "=")
        modReport.Emit "Wrapper vs engine  (full = RegExp.Execute; engine = MatchNext loop, no objects)"
        modReport.Emit String$(80, "-")
        modReport.Emit PadR("case", 26) & PadL("engine ns", 15) & PadL("full ns", 15) & PadL("wrapper %", 12)
        modReport.Emit String$(80, "-")

        DiagRow "word_token  \w+", "\w+", "g", large
        DiagRow "char_class  [A-Za-z]+", "[A-Za-z]+", "g", large
        DiagRow "email", "[\w.]+@[\w.]+", "g", large
        DiagRow "date_groups (3 subs)", "(\d{4})-(\d{2})-(\d{2})", "g", large
        DiagRow "named_dates (3 subs)", "(?<y>\d{4})-(?<m>\d{2})", "g", large

        modReport.Emit String$(80, "-")
        modReport.Emit "sink (ignore): " & CStr(gSink)
    End Sub

    Private Sub DiagRow(ByVal nm As String, ByVal pat As String, ByVal fl As String, ByRef input As String)
        Dim cFull As BenchCase, cRaw As BenchCase, mFull As Measure, mRaw As Measure
        cRaw = MakeCase(nm, pat, fl, opExecuteRaw, input, "", False)
        cFull = MakeCase(nm, pat, fl, opExecuteFull, input, "", False)
        mRaw = MeasureOurs(cRaw)
        mFull = MeasureOurs(cFull)

        Dim wrapPct As String
        If mFull.nsPerOp > 0 Then
            wrapPct = Format$((mFull.nsPerOp - mRaw.nsPerOp) / mFull.nsPerOp * 100, "0.0") & "%"
        Else
            wrapPct = "-"
        End If
        modReport.Emit PadR(nm, 26) & PadL(Format$(mRaw.nsPerOp, "#,##0"), 15) & _
                       PadL(Format$(mFull.nsPerOp, "#,##0"), 15) & PadL(wrapPct, 12)
    End Sub
    '<<< DIAG

End Module
