Module modParity
    Option Explicit
    ' ==========================================================================
    ' modParity - correctness guard for the RegExp replacement class
    '
    ' Compares OUR output against the real VBScript.RegExp across the features
    ' COM 5.5 supports (Test / Execute / Replace, numbered groups, g/i/m), plus
    ' SmokeOurs for features COM can't judge (named groups, DotAll, Split).
    '
    '   * IDE:  execute RunParity (F5) -> Immediate pane + %TEMP%\regexp_parity_<ts>.txt
    '   * EXE:  RunSuite() in modBench calls ParityCore first, so the form button
    '           gets parity + benchmark in one report.
    '
    ' Requires modReport.twin. Do NOT add the VBScript regex reference; late-bound.
    ' ==========================================================================

    Private mFails As Long
    Private mChecks As Long

    ' IDE entry: parity on its own.
    Public Sub RunParity()
        modReport.Reset
        ParityCore
        Dim p As String
        p = modReport.Flush("regexp_parity")
        Debug.Print "report written: " & p
    End Sub

    ' Worker: emits only (no reset/flush) so modBench.RunSuite can compose it.
    Public Sub ParityCore()
        mFails = 0
        mChecks = 0

        Dim oCom As Object
        On Error Resume Next
        Set oCom = CreateObject("VBScript.RegExp")
        On Error GoTo 0
        If oCom Is Nothing Then
            modReport.Emit "VBScript.RegExp unavailable - running smoke checks only."
            SmokeOurs
            Report
            Exit Sub
        End If

        Dim ml As String
        ml = "The fox" & vbCrLf & "The dog" & vbCrLf & "the cat"

        ' ---- Execute parity (pattern, flags, input) ----
        CheckExecute oCom, "\w+", "g", "The quick 2021 fox!"
        CheckExecute oCom, "(\d{4})-(\d{2})-(\d{2})", "g", "on 2021-06-09 and 2026-07-16 done"
        CheckExecute oCom, "cat|dog", "gi", "Cat DOG dog CAT cAt"
        CheckExecute oCom, "^The", "gm", ml
        CheckExecute oCom, "colou?r", "g", "color and colour here"
        CheckExecute oCom, "a(b)?c", "g", "ac abc adc ac"          ' non-participating group
        CheckExecute oCom, "[\w.]+@[\w.]+", "g", "a1@b2.co x@y.z no"
        CheckExecute oCom, "\bfox\b", "", "a fox foxed the foxhole fox"
        CheckExecute oCom, "\s+", "g", "a  b" & vbTab & "c" & vbCrLf & "d"
        CheckExecute oCom, "z+", "g", "no match here"             ' zero matches
        CheckExecute oCom, "(a)(b)(c)", "g", "abcabc"
        CheckExecute oCom, "[a-c]", "gi", "A big Cab, zZ, Bc"   ' bare RANGES first + i flag

        ' ---- Test parity ----
        CheckTest oCom, "^\d+$", "", "12345"
        CheckTest oCom, "^\d+$", "", "12a45"
        CheckTest oCom, "fox", "i", "The FOX"
        CheckTest oCom, "^$", "", ""

        ' ---- Replace parity ----
        CheckReplace oCom, "\d", "g", "a1b2c3", "#"
        CheckReplace oCom, "(\w)(\w)", "g", "abcdef", "$2$1"
        CheckReplace oCom, "\s+", "g", "a   b  c", " "
        CheckReplace oCom, "cat", "gi", "Cat cat CAT", "dog"

        ' ---- features COM can't judge ----
        SmokeOurs

        Report
    End Sub

    ' ======================================================================
    ' Comparisons
    ' ======================================================================
    Private Sub CheckExecute(ByRef oCom As Object, ByVal pat As String, ByVal fl As String, ByRef inp As String)
        Dim re As RegExp
        Set re = New RegExp
        re.Flags = fl
        re.Pattern = pat
        SetupCom oCom, pat, fl

        Dim a As MatchCollection, b As Object
        Set a = re.Execute(inp)
        Set b = oCom.Execute(inp)

        Dim label As String
        label = "Execute /" & pat & "/" & fl

        If Not Eq(label & " count", a.Count, b.Count) Then Exit Sub

        Dim i As Long, j As Long
        For i = 0 To a.Count - 1
            Dim ma As Match, mb As Object
            Set ma = a.Item(i)
            Set mb = b.Item(i)
            Eq label & " [" & i & "].Value", ma.Value, ("" & mb.Value)
            Eq label & " [" & i & "].FirstIndex", ma.FirstIndex, CLng(mb.FirstIndex)
            Eq label & " [" & i & "].Length", ma.Length, CLng(mb.Length)

            Dim sa As SubMatches, sb As Object
            Set sa = ma.SubMatches
            Set sb = mb.SubMatches
            If Eq(label & " [" & i & "].SubMatches.Count", sa.Count, sb.Count) Then
                For j = 0 To sa.Count - 1
                    Eq label & " [" & i & "].SubMatches(" & j & ")", ("" & sa.Item(j)), ("" & sb.Item(j))
                Next j
            End If
        Next i
    End Sub

    Private Sub CheckTest(ByRef oCom As Object, ByVal pat As String, ByVal fl As String, ByRef inp As String)
        Dim re As RegExp
        Set re = New RegExp
        re.Flags = fl
        re.Pattern = pat
        SetupCom oCom, pat, fl
        Eq "Test /" & pat & "/" & fl & " on <" & Left$(inp, 12) & ">", re.Test(inp), oCom.Test(inp)
    End Sub

    Private Sub CheckReplace(ByRef oCom As Object, ByVal pat As String, ByVal fl As String, ByRef inp As String, ByVal rep As String)
        Dim re As RegExp
        Set re = New RegExp
        re.Flags = fl
        re.Pattern = pat
        SetupCom oCom, pat, fl
        Eq "Replace /" & pat & "/" & fl, re.Replace(inp, rep), oCom.Replace(inp, rep)
    End Sub

    ' ======================================================================
    ' Smoke checks for features the COM oracle can't judge (hand-verified)
    ' ======================================================================
    Private Sub SmokeOurs()
        Dim re As RegExp

        ' named captures - value + name key both resolve
        Set re = New RegExp
        re.Flags = "g"
        re.Pattern = "(?<y>\d{4})-(?<m>\d{2})"
        Dim mc As MatchCollection
        Set mc = re.Execute("2021-06 then 2026-07")
        If Eq("named count", mc.Count, 2) Then
            Eq "named [0] by index", mc.Item(0).SubMatches.Item(0), "2021"
            Eq "named [0] by name 'y'", mc.Item(0).SubMatches.Item("y"), "2021"
            Eq "named [0] by name 'm'", mc.Item(0).SubMatches.Item("m"), "06"
            Eq "named [1] by name 'y'", mc.Item(1).SubMatches.Item("y"), "2026"
        End If

        ' DotAll: '.' crosses newline only with 's'
        Set re = New RegExp
        re.Pattern = "a.b"
        re.Flags = "s"
        Eq "dotall on", re.Test("a" & vbLf & "b"), True
        re.Flags = ""
        Eq "dotall off", re.Test("a" & vbLf & "b"), False

        ' Split
        Set re = New RegExp
        re.Flags = "g"
        re.Pattern = "\s+"
        Dim parts As Collection
        Set parts = re.Split("one  two" & vbTab & "three")
        If Eq("split count", parts.Count, 3) Then
            Eq "split(1)", parts.Item(1), "one"
            Eq "split(3)", parts.Item(3), "three"
        End If
        
        ' code unit > &H7FFF exercises the SetInput decode fold / CopyMemory sign bits
        Dim hi As String
        hi = ChrW$(&HF900&)
        Set re = New RegExp
        re.Pattern = "a" & hi & "b"
        Eq "high-codeunit match", re.Test("a" & hi & "b"), True
        Eq "high-codeunit nomatch", re.Test("axb"), False
        
        ' pattern validation surface
        Set re = New RegExp
        re.Pattern = "("                       ' unterminated group -> invalid
        Eq "invalid pattern IsValid", re.IsValid, False
        Eq "invalid pattern has LastError", (Len(re.LastError) > 0), True
        re.Pattern = "a(b)c"                    ' valid
        Eq "valid pattern IsValid", re.IsValid, True
        Eq "valid pattern no LastError", (Len(re.LastError) = 0), True
        
        ' $<name> substitution in Replace
        Set re = New RegExp
        re.Global = True
        re.Pattern = "(?<m>\w{3})-(?<d>\d{1,2})-(?<y>\d{4})"
        Eq "Replace $<name>", re.Replace("Jul-4-1776", "$<y>/$<m>/$<d>"), "1776/Jul/4"
        Eq "Replace $<name> + $n mix", re.Replace("Jul-4-1776", "$<y> ($1)"), "1776 (Jul)"
    End Sub

    ' ======================================================================
    ' Helpers
    ' ======================================================================
    Private Sub SetupCom(ByRef oCom As Object, ByVal pat As String, ByVal fl As String)
        oCom.Pattern = pat
        oCom.Global = (InStr(LCase$(fl), "g") > 0)
        oCom.IgnoreCase = (InStr(LCase$(fl), "i") > 0)
        oCom.MultiLine = (InStr(LCase$(fl), "m") > 0)
    End Sub

    ' Returns True on pass. Logs on failure. Variant compare keeps call sites terse.
    Private Function Eq(ByVal label As String, ByVal got As Variant, ByVal want As Variant) As Boolean
        mChecks = mChecks + 1
        If CStr(got) = CStr(want) Then
            Eq = True
        Else
            mFails = mFails + 1
            modReport.Emit "FAIL  " & label & "   got=<" & CStr(got) & ">  want=<" & CStr(want) & ">"
        End If
    End Function

    Private Sub Report()
        modReport.Emit String$(60, "-")
        If mFails = 0 Then
            modReport.Emit "PARITY OK  (" & mChecks & " checks passed)"
        Else
            modReport.Emit "PARITY FAILED  " & mFails & " of " & mChecks & " checks"
        End If
    End Sub

End Module

' ==========================================================================
' Optional: same checks under the twinBASIC Unit Testing add-on.
' Assert.AreEqual is the default-strictness member of the Assert package.
' Enable the Unit Testing add-on and run these from the Test panel, or ignore
' this module and rely on RunParity above.
' ==========================================================================
Module modParityTests
    Option Explicit

    Sub Execute_WordToken_MatchesCom()
        Dim re As RegExp
        Set re = New RegExp
        re.Flags = "g"
        re.Pattern = "\w+"
        Dim mc As MatchCollection
        Set mc = re.Execute("The quick 2021 fox")
        Assert.Strict.AreEqual 4, mc.Count
        Assert.Strict.AreEqual "The", mc.Item(0).Value
        Assert.Strict.AreEqual 0&, mc.Item(0).FirstIndex
        Assert.Strict.AreEqual "fox", mc.Item(3).Value
    End Sub

    Sub NamedCapture_ResolvesByName()
        Dim re As RegExp
        Set re = New RegExp
        re.Pattern = "(?<y>\d{4})-(?<m>\d{2})"
        Dim mc As MatchCollection
        Set mc = re.Execute("2026-07")
        Assert.Strict.AreEqual "2026", mc.Item(0).SubMatches.Item("y")
        Assert.Strict.AreEqual "07", mc.Item(0).SubMatches.Item("m")
    End Sub
    Sub Replace_Backreference()
        Dim re As RegExp
        Set re = New RegExp
        re.Flags = "g"
        re.Pattern = "(\w)(\w)"
        Assert.Strict.AreEqual "badcfe", re.Replace("abcdef", "$2$1")
    End Sub
    
    ' Build a one-code-unit string from a 0..65535 value, folding > &H7FFF into the
    ' signed range ChrW$ accepts. Keeps all non-ASCII out of the source file so nothing
    ' depends on how the .twin is saved/pasted.
    Private Function CU(ByVal n As Long) As String
        If n >= &H8000& Then n = n - &H10000
        CU = ChrW$(n)
    End Function

    Public Sub RunUnicodeCheck()
        modReport.Reset

        Dim oCom As Object
        On Error Resume Next
        Set oCom = CreateObject("VBScript.RegExp")
        On Error GoTo 0
        If oCom Is Nothing Then
            modReport.Emit "VBScript.RegExp unavailable - cannot compare."
            Debug.Print "report written: " & modReport.Flush("regexp_unicode")
            Exit Sub
        End If

        modReport.Emit "=== Unicode capability vs VBScript.RegExp ==="
        modReport.Emit "SAME = identical behaviour. DIFFER = we matched where COM didn't (more capable)."
        modReport.Emit "OURS BEHIND = COM matched and we didn't  <-- the only bad outcome."
        modReport.Emit String$(72, "-")

        Dim ea1 As String, EA2 As String, decomp As String, emoji As String, han As String
        ea1 = CU(&HE9&)                    ' precomposed e-acute (lowercase)
        EA2 = CU(&HC9&)                    ' precomposed E-acute (uppercase)
        decomp = "e" & CU(&H301&)          ' e + combining acute accent
        emoji = CU(&HD83D&) & CU(&HDE00&)  ' U+1F600 (surrogate pair)
        han = CU(&H6587&) & CU(&H8A00&)    ' CJK characters

        ' literal BMP  -- baseline, expect SAME (both match)
        UniRow oCom, "literal accented BMP", "caf" & ea1, "", "x caf" & ea1 & " y"
        UniRow oCom, "literal CJK BMP", han, "", "x" & han & "y"

        ' normalization -- lowercase precomposed vs lowercase decomposed; expect SAME (both no-match)
        UniRow oCom, "precomposed pat vs decomposed text", ea1, "", decomp

        ' case folding under IgnoreCase -- lowercase pattern vs UPPERCASE text (the real fold test)
        UniRow oCom, "fold Latin accented (i)", "caf" & ea1, "i", "CAF" & EA2
        UniRow oCom, "fold Greek alpha/Alpha (i)", CU(&H3B1&), "i", CU(&H391&)
        UniRow oCom, "fold Cyrillic a/A (i)", CU(&H430&), "i", CU(&H410&)

        ' astral / surrogate -- neither has u-mode
        UniRow oCom, "astral literal (emoji)", emoji, "", "x" & emoji & "y"
        UniRow oCom, "astral single char (^.$ on emoji)", "^.$", "", emoji

        ' ASCII-ness of \w and \d
        UniRow oCom, "\w matches CJK letter?", "\w", "", CU(&H6587&)
        UniRow oCom, "\w matches accented letter?", "\w", "", ea1
        UniRow oCom, "\d matches fullwidth digit?", "\d", "", CU(&HFF13&)
        UniRow oCom, "\d matches Arabic-Indic digit?", "\d", "", CU(&H663&)

        modReport.Emit String$(72, "-")
        Debug.Print "report written: " & modReport.Flush("regexp_unicode")
    End Sub

    Private Sub UniRow(ByRef oCom As Object, ByVal desc As String, ByVal pat As String, _
                       ByVal fl As String, ByRef input As String)
        Dim re As RegExp
        Set re = New RegExp
        re.Flags = fl
        re.Pattern = pat

        oCom.Pattern = pat
        oCom.Global = (InStr(LCase$(fl), "g") > 0)
        oCom.IgnoreCase = (InStr(LCase$(fl), "i") > 0)
        oCom.MultiLine = (InStr(LCase$(fl), "m") > 0)

        Dim o As Boolean, c As Boolean, comErr As Boolean
        o = re.Test(input)
        On Error Resume Next
        c = oCom.Test(input)
        comErr = (Err.Number <> 0)
        On Error GoTo 0

        Dim verdict As String
        If comErr Then
            verdict = "ours=" & o & "  COM=<error>   (ours handles it)"
        ElseIf o = c Then
            verdict = "ours=" & o & "  COM=" & c & "   SAME"
        ElseIf (o = False) And (c = True) Then
            verdict = "ours=False COM=True    <-- OURS BEHIND"
        Else
            verdict = "ours=" & o & "  COM=" & c & "   DIFFER (ours more capable)"
        End If

        modReport.Emit Left$(desc & Space$(38), 38) & verdict
    End Sub

End Module
