' ==========================================================================
' This file was automatically generated from the ActiveX DLL version source.
' COM machinery stripped out for twinBASIC package.
' ==========================================================================
' ==========================================================================
' TextStream
'
' An FSO-style TextStream for the FileSystemTools module, built for very large files.
'
' It streams text by READING raw bytes through twinBASIC's Binary Get and WRITING
' raw bytes through Win32 WriteFile, doing all transcoding through the shared
' TextCodec module (the same converters used by
' FileSystemTools.TextFileToString/StringToTextFile). It deliberately does NOT use
' tB's "Open ... Encoding ..." clause: that clause does not reliably transcode
' multi-byte UTF-8 on read (a valid C3 A9 decodes to U+FFFD), so relying on it
' would silently corrupt any non-ASCII text.
'
' On read, a small carry buffer holds any partial multi-byte sequence that
' straddles a chunk boundary, so chunked decoding is exact. On write, the
' output buffer is flushed in chunks without ever splitting a surrogate pair.
'
' Encoding is chosen by FileSystemTools.OpenTextFile, either explicitly or via
' TextCodec.Detect over a 64 KB head sample. Classify decides whether
' the encoding can be byte-streamed (UTF-8/16/32, single-byte, DBCS, GB18030) and
' supplies the boundary strategy; only stateful UTF-7 and code pages GetCPInfo
' cannot classify fall back to a buffered whole-file path. All encoding logic lives
' in TextCodec. The public surface is identical in both modes.
'
' Created via:  Set ts = FileSystemTools.OpenTextFile(path, ForReading)
'               (or CreateTextFile - do not New this class directly)
'
' --- Why reads and writes use different plumbing -------------------------
'   * tB's positionless Get/Put IS 64-bit safe - a 2.4GB file streams correctly.
'   * But LOF() is Long and WRAPS negative past 2^31, and Seek() takes a Long and
'     cannot express an offset beyond it (a >2GB append failed with a bare E_FAIL).
' Reads only ever move forward, and the one Seek they need is the tiny BOM skip -
' so the read path stays on VB Binary I/O.
' Writes are different: appending REQUIRES positioning at EOF first, which a
' 32-bit Seek cannot do. So the write path uses a Win32 handle opened with
' FILE_APPEND_DATA, where every WriteFile lands at EOF atomically - no seek, no
' size query, no 2GB ceiling. Fresh writes use a handle too, purely so there is
' ONE write path rather than a size-dependent fork.
'
' --- THREE MODES, one public surface -------------------------------------
' Every public member has to work in all three. When debugging, first establish
' which one you are in, because they share almost no state:
'
'   1. STREAMING  (mStreaming = True, mIsStd = False)
'      The intended path.
'      READS:  a tB Binary file number (mFile) + chunked Get.
'              State: mBytesRemaining / mCarry / mDecoded / mDecPos.
'      WRITES: a Win32 handle (mHandle) + WriteFile.
'              State: mWriteBuf, flushed at STREAM_CHUNK.
'      Exactly one of mFile / mHandle is ever non-zero on a given instance.
'
'   2. BUFFERED   (mStreaming = False, mIsStd = False)
'      Fallback when Classify() cannot find a chunk-boundary rule for the code
'      page (UTF-7, exotic MBCS). Whole file lives in mBuffer; mPos is the
'      cursor; writes are committed once, on Close, via FileSystemTools.WriteStream.
'      NO handle of either kind is held open in this mode.
'
'   3. STANDARD   (mIsStd = True)
'      stdin/stdout/stderr via a Win32 handle (mStdHandle) we do NOT own.
'      Entirely separate state (mStd*), and every public member that supports it
'      short-circuits to a Std* helper on its FIRST line, before the Ensure*
'      guards. See the caveats in the OpenStandardStream helpers region.
'
' --- Invariants ----------------------------------------------------------
' * The BOM is dealt with exactly once, at open: skipped by a Seek on read
'   (OpenReadStream), written by OpenWriteFresh, never re-emitted on append.
'   Everything after that uses BARE code pages (mCp) via TextCodec.*Bytes, so no
'   chunk ever grows a spurious BOM. The buffered path is the exception - it uses
'   the sign-carrying TextCodec.Encode/Decode, which handle the BOM themselves.
' * mDecPos / mPos are 1-BASED string cursors; the byte arrays are 0-based.
' * mFile = 0 means "no read handle" - FreeFile never returns 0.
'   mHandle = 0 means "no write handle" - INVALID_HANDLE_VALUE is normalized to 0.
' ==========================================================================
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================
[Hidden(False)]
[Description("A streaming text reader/writer returned by FileSystem.OpenTextFile, supporting auto-detected and explicit encodings with large-file streaming.")]
Public Class TextStream
    Option Explicit
    
    Private Const ERR_NOT_TEXT As Long = 5   ' shared "refused: content isn't decodable text"
    
    ' Serves double duty: the read chunk size, the write flush threshold, AND the
    ' head-sample size used for encoding detection in the Init* routines.
    Private Const STREAM_CHUNK As Long = 65536    ' raw bytes per read; flush threshold for writes

    ' --- Win32 write-path constants ---
    ' FILE_APPEND_DATA must be passed ALONE. OR-ing it with GENERIC_WRITE grants
    ' FILE_WRITE_DATA, which restores normal pointer-relative writes and would make
    ' an append start at position 0 - i.e. silently overwrite the file from the top.
    Private Const GENERIC_WRITE    As Long = &H40000000
    Private Const FILE_APPEND_DATA As Long = &H4
    Private Const FILE_SHARE_READ  As Long = &H1
    Private Const CREATE_ALWAYS    As Long = 2      ' create, truncating any existing file
    Private Const OPEN_EXISTING    As Long = 3

    '--- resolved at Init, then read-only -------------------------------
    Private mPath As String
    Private mMode As IOMode
    Private mEnc As TextEncoding              ' resolved encoding, signed (serves the Encoding property + BOM)
    Private mCp As Long                       ' bare code page = CodePageOf(mEnc) (chunk decode/encode, Classify)
    Private mLineEnding As String             ' newline emitted by WriteLine

    Private mStreaming As Boolean             ' True: byte-streaming; False: buffered whole-file
    Private mFile As Long                     ' tB file number - STREAMING READS ONLY (Binary mode)
    Private mHandle As LongPtr                ' Win32 handle - STREAMING WRITES ONLY (0 = none)

    ' --- streaming READ state ---
    ' The chunk pipeline is: disk -> mCarry+chunk -> [complete prefix | new mCarry]
    '                              -> decode -> append to mDecoded -> serve from mDecPos.
    Private mKind As DecodeKind               ' boundary strategy (from Classify)
    Private mLeadRanges() As Byte             ' DBCS lead-byte ranges (used when mKind = dkDBCS)
    Private mBytesRemaining As LongLong       ' undelivered source bytes (after any BOM)
    Private mCarry() As Byte                  ' partial multi-byte sequence carried across chunks
    Private mDecoded As String                ' decoded text window not yet consumed (+ lookahead)
    Private mDecPos As Long                   ' 1-based cursor into mDecoded

    ' --- streaming WRITE state ---
    Private mWriteBuf As String               ' pending text not yet encoded to disk

    ' --- buffered (fallback) state ---
    Private mBuffer As String                 ' whole-file content
    Private mPos As Long                      ' 1-based read cursor
    Private mDirty As Boolean                 ' buffered write pending

    ' --- shared ---
    Private mLine As Long                     ' 1-based current line
    Private mColumn As Long                   ' 1-based current column
    Private mClosed As Boolean

    ' --- fields (standard-stream mode) ---
    ' Parallel state to the streaming read fields above; mStdRaw/mStdInBuf play the
    ' roles of mCarry/mDecoded. Kept separate because the source is a handle we do
    ' not own and cannot Seek or size in advance.
    Private mIsStd As Boolean
    Private mStdHandle As LongPtr
    Private mStdInput As Boolean
    Private mStdCp As Long                      ' bare code page: encUtf16 (wide) or encSystemAnsi (ANSI)
    Private mStdKind As DecodeKind              ' boundary kind for reads
    Private mStdLead() As Byte                  ' DBCS lead ranges, if any
    Private mStdRaw() As Byte                   ' undecoded bytes carried across reads
    Private mStdInBuf As String                 ' decoded-but-unconsumed text
    Private mStdEof As Boolean
    
    ' How the streaming reader finds character boundaries within a raw chunk.
    ' Set once by Classify(); consumed only by CompletePrefixLen() and its helpers.
    ' Adding a member here means adding a *PrefixLen partner down in the
    ' classification region - the two must stay in step.
    Private Enum DecodeKind
        dkSingle          ' 1 byte = 1 char
        dkUtf8            ' self-synchronizing, 1-4 bytes
        dkUtf16LE
        dkUtf16BE
        dkUtf32           ' LE or BE; fixed 4-byte units
        dkDBCS            ' lead/trail double-byte (Big5, GB2312/GBK, DBCS ANSI)
        dkGB18030         ' 1/2/4-byte
    End Enum

    '======================================================================
    ' Initialization (called only by FileSystemTools.OpenTextFile)
    '
    ' All three Init* routines follow the same shape:
    '   resolve the encoding -> mEnc/mCp -> Classify() -> streaming or buffered.
    ' Classify() is the fork in the road: it decides which of the two file modes
    ' this instance will live in, and nothing changes that afterwards.
    '======================================================================
    Friend Sub Init(ByVal filePath As String, ByVal ioMode As IOMode, ByVal create As Boolean, ByVal format As TextEncoding, ByVal lineEnding As NewlineType)
        ' Resolved to absolute HERE, once, rather than stored as given. The buffered
        ' path defers its only disk write to Close (FlushBuffered -> WriteStream), so
        ' a relative mPath would resolve against whatever the CWD happens to be at
        ' CLOSE time - not at open time. A caller who changes directory between
        ' opening and closing would silently write to a different folder than the one
        ' it read from.
        '
        ' The streaming paths do not have that exposure (their handles are opened
        ' during Init), but resolving for all three keeps mPath canonical, which also
        ' makes every error message below report a full path instead of "a.txt".
        mPath = FileSystemTools.GetAbsolutePathName(filePath)
        ' Bad-name guard: only creation can hit an illegal name. Validating up front
        ' keeps the error identical (FSO's 52) regardless of which open path is taken.
        If create Then GuardCreateName filePath, "CreateTextFile"
        mMode = ioMode
        mPos = 1
        mLine = 1
        mColumn = 1
        mClosed = False
        mDirty = False
        ReDim mLeadRanges(0 To 11)          ' CPINFO.LeadByte is 12 bytes: 6 lo/hi pairs

        ' nlNoChange/nlUnknown/nlMixed (all 0) land in Else -> CRLF. A stream always
        ' needs a concrete newline to emit, so there is no "leave it alone" option.
        Select Case lineEnding
            Case nlUnix:      mLineEnding = vbLf
            Case nlMacintosh: mLineEnding = vbCr
            Case Else:        mLineEnding = vbCrLf
        End Select

        Select Case ioMode
            Case ForReading:   InitReading format
            Case ForWriting:   InitWriting format, create
            Case ForAppending: InitAppending format, create
            Case Else:         Err.Raise 5, "TextStream", "Invalid IOMode"
        End Select
    End Sub

    ' Reads a head sample to resolve the encoding, then either opens a byte stream
    ' (skipping the BOM) or slurps the whole file into mBuffer.
    ' NOTE: on the buffered path the file is read TWICE - once for the sample, once
    ' in full. Acceptable only because that path is the rare fallback.
    Private Sub InitReading(ByVal format As TextEncoding)
        If Not FileSystemTools.FileExists(mPath) Then Err.Raise 53, "TextStream", "File not found: " & mPath

        Dim sample() As Byte
        FileSystemTools.ReadStream mPath, sample, STREAM_CHUNK

        If Not IsArrayInitialized(sample) Then
            ' Empty file - pick an encoding for reporting; reads yield EOF
            If format = encAutoDetect Then mEnc = encUtf8 Else mEnc = TextCodec.CodePageOf(format)
        Else
            mEnc = TextCodec.Detect(sample, format)        ' BOM wins; else seed; else heuristics
            ' encUnknown is only reachable on the auto-detect path (Detect trusts a
            ' concrete seed), so an explicit encoding will never raise here.
            If mEnc = encUnknown Then Err.Raise ERR_NOT_TEXT, "TextStream", _
                "File appears to be binary; cannot open as text: " & mPath
        End If

        mCp = TextCodec.CodePageOf(mEnc)

        If Classify(mCp, mKind, mLeadRanges) Then
            mStreaming = True
            OpenReadStream TextCodec.BomLen(mEnc)         ' Seek past the BOM once, here
        Else
            mStreaming = False
            Dim full() As Byte
            FileSystemTools.ReadStream mPath, full
            If IsArrayInitialized(full) Then
                mBuffer = TextCodec.Decode(full, mEnc, nlNoChange)   ' strips a leading BOM
            Else
                mBuffer = vbNullString
            End If
            mPos = 1
        End If
    End Sub
    
    ' Append has two quite different jobs depending on whether the file exists:
    '   * missing  -> identical to a fresh write (BOM emitted, caller's newline used)
    '   * existing -> adopt the file's OWN encoding, BOM and newline style, so we
    '                 never turn a consistent file into a mixed one.
    Private Sub InitAppending(ByVal format As TextEncoding, ByVal create As Boolean)
        If Not FileSystemTools.FileExists(mPath) Then
            ' New file: an "append" to nothing is just a fresh write
            If Not create Then Err.Raise 53, "TextStream", "File not found: " & mPath
            If format = encAutoDetect Then format = encUtf8    ' auto has no meaning with no bytes to detect
            mEnc = format
            mCp = TextCodec.CodePageOf(mEnc)

            If Classify(mCp, mKind, mLeadRanges) Then
                mStreaming = True
                OpenWriteFresh                    ' fresh file -> may emit a BOM
            Else
                mStreaming = False
                mBuffer = vbNullString
                mDirty = True
            End If
            Exit Sub
        End If

        ' Existing file: preserve its encoding/BOM (auto), or use the given one
        Dim sample() As Byte
        FileSystemTools.ReadStream mPath, sample, STREAM_CHUNK

        If Not IsArrayInitialized(sample) Then
            ' Empty existing file = fresh write: keep the caller's lineEnding
            If format = encAutoDetect Then mEnc = encUtf8 Else mEnc = format
        Else
            mEnc = TextCodec.Detect(sample, format)        ' BOM wins; else seed; else heuristics
            If mEnc = encUnknown Then Err.Raise ERR_NOT_TEXT, "TextStream", _
                "File appears to be binary; cannot open as text: " & mPath

            ' Non-empty existing file: append in the file's OWN newline style, so we
            ' never turn a clean file mixed. The caller's lineEnding is ignored here -
            ' it governs only fresh writes (ForWriting, or append to an empty file).
            ' A mixed or newline-less file has no single style to match, so we keep
            ' the caller's value (already in mLineEnding).
            ' Sampled, not exact: the style is judged from the 64 KB HEAD only, so a
            ' file that changes style later on is matched to whatever its head used.
            Dim existingNl As String
            existingNl = TextCodec.GetNewLine( _
                TextCodec.DetectNewlineType(TextCodec.Decode(sample, mEnc, nlNoChange)))
            If Len(existingNl) > 0 Then mLineEnding = existingNl   ' 0-length = nlMixed/nlUnknown -> keep caller's
        End If

        mCp = TextCodec.CodePageOf(mEnc)

        If Classify(mCp, mKind, mLeadRanges) Then
            mStreaming = True
            OpenWriteAppend                        ' never re-emits a BOM
        Else
            ' Buffered append: load the existing content, park the cursor at the end,
            ' and let Write() concatenate onto it. mDirty stays False so that closing
            ' without writing anything does not needlessly rewrite the file.
            mStreaming = False
            Dim full() As Byte
            FileSystemTools.ReadStream mPath, full
            If IsArrayInitialized(full) Then mBuffer = TextCodec.Decode(full, mEnc, nlNoChange) Else mBuffer = vbNullString
            AdvancePosition mBuffer                ' Line/Column start at the end of the existing text
            mPos = Len(mBuffer) + 1
            mDirty = False
        End If
    End Sub

    ' Fresh write: truncate/create now (not lazily at Close), so an empty write still
    ' leaves a zero-length file behind.
    Private Sub InitWriting(ByVal format As TextEncoding, ByVal create As Boolean)
        If Not FileSystemTools.FileExists(mPath) And Not create Then Err.Raise 53, "TextStream", "File not found: " & mPath
        If format = encAutoDetect Then format = encUtf8     ' nothing to detect on a write

        mEnc = format
        mCp = TextCodec.CodePageOf(mEnc)

        If Classify(mCp, mKind, mLeadRanges) Then
            mStreaming = True
            OpenWriteFresh                        ' truncates/creates now; emits BOM if mEnc has one
        Else
            mStreaming = False
            mBuffer = vbNullString
            mDirty = True                         ' commit (truncate) on Close even with no writes
        End If
    End Sub

    '======================================================================
    ' Handle setup
    '
    ' Streaming mode only - the buffered path opens nothing.
    ' READS use a tB Binary file number: Binary (rather than Input/Output) so that
    ' tB does no transcoding of its own; every byte that crosses is raw.
    ' WRITES use a Win32 handle: see the header for why.
    '======================================================================

    ' Opens for read and consumes the BOM immediately, so mBytesRemaining counts
    ' only real content and no downstream code ever has to think about it again.
    Private Sub OpenReadStream(ByVal bomLen As Long)
        mFile = FreeFile()
        Open mPath For Binary Access Read As #mFile
        ' LOF() is Long and WRAPS past 2GB (verified: 2.4GB reports as -1894907904).
        ' StatPath is the only trustworthy size source.
        Dim total As LongLong
        Dim attrs As Long, cr As Date, mo As Date, ac As Date, leaf As String
        FSTShared.StatPath mPath, attrs, total, cr, mo, ac, leaf
        If bomLen > 0 And total >= bomLen Then
            Seek #mFile, bomLen + 1                  ' tiny offset: safe on a 32-bit Seek
            mBytesRemaining = total - bomLen
        Else
            mBytesRemaining = total
        End If
        Erase mCarry
        mDecoded = vbNullString
        mDecPos = 1
    End Sub

    ' Fresh write. CREATE_ALWAYS truncates any existing file
    Private Sub OpenWriteFresh()
        mHandle = CreateFileW(StrPtr(FSTShared.ApiPath(mPath)), GENERIC_WRITE, FILE_SHARE_READ, ByVal vbNullPtr, _
                              CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, 0)
        If mHandle = INVALID_HANDLE_VALUE Then
            mHandle = 0                              ' normalize: 0 is our "no handle" sentinel
            RaiseFromLastError Err.LastDllError, "TextStream", mPath
        End If
        mWriteBuf = vbNullString

        ' The one and only place a BOM is emitted. Every later write goes through
        ' EncodeBytes (bare code page), which never adds one.
        Dim bom() As Byte
        bom = TextCodec.BomBytes(mEnc)               ' empty unless mEnc is BOM-bearing
        If TextCodec.SafeCountB(bom) > 0 Then WriteBytes bom
    End Sub

    ' Append. FILE_APPEND_DATA *alone* is what makes every WriteFile land at EOF
    ' atomically - see the constant's declaration for why it must not be OR'd with
    ' GENERIC_WRITE.
    '
    ' No LOF, no Seek, no size guard: unbounded by construction. This is the whole
    ' reason the write path moved off VB file I/O, whose 32-bit Seek could not
    ' position at the end of a >2GB file (it failed with a bare E_FAIL).
    ' No BOM either - the file already has one or was never meant to.
    Private Sub OpenWriteAppend()
        mHandle = CreateFileW(StrPtr(FSTShared.ApiPath(mPath)), FILE_APPEND_DATA, FILE_SHARE_READ, ByVal vbNullPtr, _
                              OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, 0)
        If mHandle = INVALID_HANDLE_VALUE Then
            mHandle = 0
            RaiseFromLastError Err.LastDllError, "TextStream", mPath
        End If
        mWriteBuf = vbNullString
    End Sub

    '======================================================================
    ' Reading
    '
    ' Each public reader is the same three-part shape: std short-circuit, guard,
    ' then a streaming/buffered fork. The buffered arms are trivial Mid$ slicing;
    ' the interesting work is all in the streaming arms and in FillSome().
    '======================================================================
    [Description("Reads the specified number of characters and returns the resulting string.")]
    Public Function Read(ByVal characters As Long) As String
        If mIsStd Then Read = StdReadChars(characters): Exit Function
        EnsureReadable
        If characters < 0 Then Err.Raise 5, "TextStream.Read", "Invalid character count"
        If characters = 0 Then Exit Function
        If AtEndOfStream Then Err.Raise 62, "TextStream.Read", "Input past end of file"

        Dim s As String
        If mStreaming Then
            EnsureChars characters                        ' pull chunks until we have enough (or EOS)
            Dim avail As Long
            avail = Available()
            If characters > avail Then characters = avail  ' short read at EOF is not an error
            s = Mid$(mDecoded, mDecPos, characters)
            mDecPos = mDecPos + characters
        Else
            Dim availB As Long
            availB = Len(mBuffer) - mPos + 1
            If characters > availB Then characters = availB
            s = Mid$(mBuffer, mPos, characters)
            mPos = mPos + characters
        End If
        AdvancePosition s                                 ' keep Line/Column in step
        Read = s
    End Function

    ' The streaming arm's fill loop is subtler than it looks. Two distinct reasons
    ' to keep filling:
    '   (a) no break found at all yet -> need more text;
    '   (b) a break WAS found, but it is a CR sitting at the very end of the decoded
    '       window with source still unread - the next byte could be an LF, making it
    '       a CRLF. Consuming it now would report a spurious extra line.
    ' Once the loop settles, the break is re-located (the window may have grown) and
    ' the line is taken.
    [Description("Reads an entire line (up to, but not including, the newline) and returns the resulting string.")]
    Public Function ReadLine() As String
        If mIsStd Then ReadLine = StdReadLine(): Exit Function
        EnsureReadable
        If AtEndOfStream Then Err.Raise 62, "TextStream.ReadLine", "Input past end of file"

        Dim s As String
        If mStreaming Then
            Dim brk As Long, brkLen As Long
            Do
                brk = NextLineBreakIn(mDecoded, mDecPos, brkLen)
                If brk = 0 Then
                    If Not FillSome() Then Exit Do                 ' EOS: whole remainder is the line
                ElseIf IsCharCR(mDecoded, brk) And brk = Len(mDecoded) And Not SourceExhausted() Then
                    If Not FillSome() Then Exit Do                 ' trailing CR may be start of CRLF
                Else
                    Exit Do                                        ' definitive break in buffer
                End If
            Loop
            brk = NextLineBreakIn(mDecoded, mDecPos, brkLen)       ' re-locate: FillSome may have moved mDecPos
            If brk = 0 Then
                ' No terminator (last line, hit EOF): advance the column over the
                ' content; the line number does not change.
                s = Mid$(mDecoded, mDecPos)
                AdvancePosition s
                mDecPos = Len(mDecoded) + 1
            Else
                ' Crossed a terminator: AdvancePosition counts it as one line
                ' break, bumping the line and resetting the column to 1.
                ' The returned string EXCLUDES the terminator; only the position
                ' bookkeeping sees it.
                s = Mid$(mDecoded, mDecPos, brk - mDecPos)
                AdvancePosition s & Mid$(mDecoded, brk, brkLen)
                mDecPos = brk + brkLen
            End If
        Else
            Dim b2 As Long, bl2 As Long
            b2 = NextLineBreakIn(mBuffer, mPos, bl2)
            If b2 = 0 Then
                s = Mid$(mBuffer, mPos)
                AdvancePosition Mid$(mBuffer, mPos)
                mPos = Len(mBuffer) + 1
            Else
                s = Mid$(mBuffer, mPos, b2 - mPos)
                AdvancePosition Mid$(mBuffer, mPos, (b2 - mPos) + bl2)
                mPos = b2 + bl2
            End If
        End If
        ReadLine = s
    End Function

    [Description("Reads the entire remaining stream and returns the resulting string. In streaming mode this reads and decodes the remainder in a single pass, but still holds the whole remainder in memory; prefer ReadLine for very large files.")]
    Public Function ReadAll() As String
        If mIsStd Then ReadAll = StdReadAll(): Exit Function
        EnsureReadable
        Dim s As String
        If mStreaming Then
            ' Guard BEFORE consuming anything: the remainder has to fit in one Byte()
            ' and one String. Raising here leaves the stream fully usable, so the
            ' caller can switch to ReadLine.
            If mBytesRemaining > 2147483647^ Then
                Err.Raise 7, "TextStream.ReadAll", _
                    "Remaining content (" & mBytesRemaining & " bytes) exceeds the maximum " & _
                    "string size; use ReadLine or Read for a file this large."
            End If

            Dim head As String
            If mDecPos <= Len(mDecoded) Then head = Mid$(mDecoded, mDecPos)

            Dim tailBytes() As Byte
            If mBytesRemaining > 0 Then
                ' Safe narrowing: the > 2147483647^ guard above has already run.
                ReDim tailBytes(0 To CLng(mBytesRemaining) - 1)
                Get #mFile,, tailBytes
                mBytesRemaining = 0
            End If

            ' No CompletePrefixLen call needed: this IS the final block, so any
            ' trailing partial sequence is genuinely truncated input, not a boundary
            ' artifact - decode it best-effort along with everything else.
            Dim tail As String
            If TextCodec.SafeCountB(mCarry) > 0 Then
                Dim combined() As Byte
                combined = TextCodec.ConcatBytes(mCarry, tailBytes)   ' carry MUST lead
                Erase mCarry
                If TextCodec.SafeCountB(combined) > 0 Then tail = TextCodec.DecodeBytes(combined, mCp, nlNoChange)
            ElseIf TextCodec.SafeCountB(tailBytes) > 0 Then
                tail = TextCodec.DecodeBytes(tailBytes, mCp, nlNoChange)
            End If

            s = head & tail
            mDecoded = vbNullString
            mDecPos = 1
        Else
            s = Mid$(mBuffer, mPos)
            mPos = Len(mBuffer) + 1
        End If
        AdvancePosition s
        ReadAll = s
    End Function

    ' Skip/SkipLine are deliberately thin wrappers - all the boundary and position
    ' bookkeeping stays in one place (Read/ReadLine, or the Std* helpers) rather than
    ' being duplicated. Note the asymmetry, which is FSO's: Skip at EOS is a silent
    ' no-op, SkipLine at EOS raises 62.
    [Description("Skips the specified number of characters when reading.")]
    Public Sub Skip(ByVal characters As Long)
        Dim discard As String
        If mIsStd Then
            If characters > 0 Then discard = StdReadChars(characters)   ' read and throw away
            Exit Sub
        End If
        EnsureReadable
        If characters <= 0 Then Exit Sub
        If AtEndOfStream Then Exit Sub
        discard = Read(characters)
    End Sub

    [Description("Skips the next line when reading.")]
    Public Sub SkipLine()
        Dim discard As String
        If mIsStd Then
            If StdAtEnd() Then Err.Raise 62, "TextStream.SkipLine", "Input past end of file"
            discard = StdReadLine()
            Exit Sub
        End If
        EnsureReadable
        If AtEndOfStream Then Err.Raise 62, "TextStream.SkipLine", "Input past end of file"
        discard = ReadLine()
    End Sub

    '----------------------------------------------------------------------
    ' Streaming read engine: pull raw bytes, decode complete prefix, carry
    ' any partial trailing multi-byte sequence to the next fill.
    '
    ' This is the heart of the class. The contract of FillSome():
    '   returns True  -> it made progress (bytes consumed and/or text decoded);
    '                    that does NOT guarantee mDecoded grew (see the "not even
    '                    one whole character yet" branch).
    '   returns False -> the source is exhausted AND the carry is empty. This is
    '                    the one and only definition of end-of-stream.
    ' Callers must therefore always loop on a CONDITION, never on a single call.
    '----------------------------------------------------------------------
    Private Function FillSome() As Boolean
        ' Drop already-consumed text so mDecoded stays bounded to the live window.
        ' Without this, mDecoded would grow to the size of the whole file and the
        ' "streaming" reader would quietly become a buffered one.
        If mDecPos > 1 Then
            If mDecPos > Len(mDecoded) Then
                mDecoded = vbNullString
            Else
                mDecoded = Mid$(mDecoded, mDecPos)
            End If
            mDecPos = 1
        End If

        ' End of stream: nothing left on disk and nothing held back.
        If mBytesRemaining <= 0 And TextCodec.SafeCountB(mCarry) = 0 Then
            FillSome = False
            Exit Function
        End If

        Dim chunk() As Byte
        Dim toRead As Long
        toRead = STREAM_CHUNK
        ' Only fires when mBytesRemaining < STREAM_CHUNK, so the narrowing cannot overflow.
        If toRead > mBytesRemaining Then toRead = CLng(mBytesRemaining)
        If toRead > 0 Then
            ReDim chunk(0 To toRead - 1)
            Get #mFile,, chunk               ' sequential: no Seek, the handle tracks position
            mBytesRemaining = mBytesRemaining - toRead
        End If

        ' Re-attach the partial sequence held back last time. Order matters: the
        ' carry bytes are the HEAD of the character that straddled the boundary.
        Dim combined() As Byte
        combined = TextCodec.ConcatBytes(mCarry, chunk)
        Erase mCarry

        Dim total As Long
        total = TextCodec.SafeCountB(combined)
        If total = 0 Then
            FillSome = False
            Exit Function
        End If

        Dim prefixLen As Long
        If mBytesRemaining <= 0 Then
            prefixLen = total                          ' final block: decode everything (best effort)
        Else
            prefixLen = CompletePrefixLen(combined, total, mKind, mLeadRanges)
            If prefixLen <= 0 Then
                ' Pathological but possible: the whole chunk is one incomplete
                ' character (or a stream of continuation bytes). Carry it all and
                ' report progress - the next call reads more. This is the case that
                ' makes "True" not imply "mDecoded grew".
                mCarry = combined                      ' not even one full char yet; need more bytes
                FillSome = True
                Exit Function
            End If
        End If

        Dim prefix() As Byte
        prefix = TextCodec.SliceBytes(combined, 0, prefixLen - 1)
        If prefixLen < total Then mCarry = TextCodec.SliceBytes(combined, prefixLen, total - 1)

        mDecoded = mDecoded & TextCodec.DecodeBytes(prefix, mCp, nlNoChange)   ' bare cp: never re-strips a BOM
        FillSome = True
    End Function

    ' Fill until at least n characters are buffered, or the source runs dry.
    ' Deliberately does NOT raise on a short fill - the caller clamps.
    Private Sub EnsureChars(ByVal n As Long)
        Do While Available() < n
            If Not FillSome() Then Exit Do
        Loop
    End Sub

    ' Decoded characters not yet handed to the caller.
    Private Function Available() As Long
        Available = Len(mDecoded) - mDecPos + 1
    End Function

    ' True when no more bytes can arrive - both the file and the carry are empty.
    ' Used by ReadLine to decide whether a trailing CR could still become a CRLF.
    Private Function SourceExhausted() As Boolean
        SourceExhausted = (mBytesRemaining <= 0 And TextCodec.SafeCountB(mCarry) = 0)
    End Function

    '======================================================================
    ' Writing
    '
    ' Streaming: accumulate text in mWriteBuf, encode + WriteFile once it reaches
    ' STREAM_CHUNK. Buffered: accumulate everything in mBuffer and commit once, on
    ' Close. Either way the caller sees the same API and the same Line/Column.
    '======================================================================
    [Description("Writes the specified string to the stream (no trailing newline).")]
    Public Sub Write(ByVal text As String)
        If mIsStd Then StdWriteString text: Exit Sub
        EnsureWritable
        If mStreaming Then
            mWriteBuf = mWriteBuf & text
            If Len(mWriteBuf) >= STREAM_CHUNK Then FlushWriteChunk False   ' False: hold back a lone surrogate
        Else
            mBuffer = mBuffer & text          ' O(n^2) over many small writes - the fallback path's cost
            mDirty = True
        End If
        AdvancePosition text
    End Sub

    ' Note the std short-circuit: it bypasses Me.Write (and therefore mStreaming and
    ' mDirty) entirely - StdWriteString does its own AdvancePosition.
    [Description("Writes the specified string followed by the stream's newline.")]
    Public Sub WriteLine(Optional ByVal text As String = "")
        If mIsStd Then StdWriteString text & mLineEnding: Exit Sub
        Me.Write text & mLineEnding
    End Sub

    [Description("Writes the specified number of blank lines to the stream.")]
    Public Sub WriteBlankLines(ByVal lines As Long)
        Dim i As Long
        If mIsStd Then For i = 1 To lines: StdWriteString mLineEnding: Next i: Exit Sub
        For i = 1 To lines
            Me.Write mLineEnding
        Next i
    End Sub

    ' NB: deliberately does NOT call FlushFileBuffers. This means "handed to the OS",
    ' not "durable on the platter" - which is FSO's meaning too. Add
    ' "FlushFileBuffers mHandle" below if durability is ever required (it is not free).
    [Description("Commits pending writes to disk. In streaming mode this encodes and writes the buffered text now; the file stays open.")]
    Public Sub Flush()
        EnsureOpen
        If mStreaming Then
            If mMode <> ForReading Then FlushWriteChunk True     ' True: flush even a trailing lone surrogate
        Else
            FlushBuffered
        End If
    End Sub

    ' Encodes and writes pending text. When flushAll is False, holds back a
    ' trailing lone high surrogate so a surrogate pair is never split mid-encode.
    '
    ' Why it matters: a high surrogate encoded on its own is not a valid character,
    ' so the encoder would substitute (or, for UTF-8/GB18030 with
    ' WC_ERR_INVALID_CHARS, fail outright) and the pair's low half would then be
    ' orphaned in the next chunk. Holding one code unit back costs nothing and makes
    ' the chunk boundary invisible in the output.
    Private Sub FlushWriteChunk(ByVal flushAll As Boolean)
        If mHandle = 0 Then Exit Sub                     ' buffered mode / read mode / already closed
        Dim cut As Long
        cut = Len(mWriteBuf)
        If cut = 0 Then Exit Sub

        If Not flushAll Then
            Dim c As Long
            c = AscW(Mid$(mWriteBuf, cut, 1)) And &HFFFF&
            If c >= &HD800& And c <= &HDBFF& Then cut = cut - 1   ' trailing high surrogate: keep it back
            If cut <= 0 Then Exit Sub                             ' buffer was JUST that surrogate
        End If

        Dim part As String
        part = Left$(mWriteBuf, cut)
        Dim bytes() As Byte
        bytes = TextCodec.EncodeBytes(part, mCp)         ' bare cp; the BOM (if any) was written at open
        If TextCodec.SafeCountB(bytes) > 0 Then WriteBytes bytes
        mWriteBuf = Mid$(mWriteBuf, cut + 1)             ' keep whatever was held back
    End Sub

    ' The single write chokepoint for the streaming path.
    ' Loops because WriteFile is PERMITTED to write fewer bytes than asked (rare on
    ' a local disk, routine on a pipe) - a bare single call would silently truncate.
    ' The written = 0 test prevents an infinite spin if the OS reports success but
    ' makes no progress.
    Private Sub WriteBytes(ByRef bytes() As Byte)
        Dim total As Long, sent As Long, written As Long
        total = TextCodec.SafeCountB(bytes)
        If total = 0 Then Exit Sub

        Do While sent < total
            written = 0
            If WriteFile(mHandle, bytes(LBound(bytes) + sent), total - sent, written, ByVal vbNullPtr) = 0 Then
                RaiseFromLastError Err.LastDllError, "TextStream", mPath
            End If
            If written = 0 Then
                Err.Raise 75, "TextStream", "Write made no progress: " & mPath
            End If
            sent = sent + written
        Loop
    End Sub

    ' Buffered commit: the whole file, rewritten in one atomic swap. Unlike the
    ' streaming path this uses the sign-carrying Encode (BOM included) because it is
    ' producing the entire file, not a chunk of one.
    Private Sub FlushBuffered()
        If mStreaming Then Exit Sub
        If Not mDirty Then Exit Sub                      ' nothing pending: don't rewrite for nothing
        Dim bytes() As Byte
        bytes = TextCodec.Encode(mBuffer, mEnc)          ' prepends the BOM when mEnc is BOM-bearing
        FileSystemTools.WriteStream bytes, mPath         ' creates/truncates
        mDirty = False
    End Sub

    '======================================================================
    ' Close
    '======================================================================
    ' Idempotent. After this, EnsureOpen makes every operation raise 52.
    ' Two handle kinds to consider now: mFile (reads) and mHandle (writes). Only one
    ' is ever non-zero on a given instance, but both are handled defensively.
    [Description("Flushes pending writes and closes the stream. Further operations raise an error.")]
    Public Sub Close()
        If mClosed Then Exit Sub
        If mIsStd Then          ' never CloseHandle a std handle - the process owns it
            mClosed = True      ' but the OBJECT is done: further use raises 52.
            Exit Sub
        End If
        If mStreaming Then
            If mMode <> ForReading Then
                FlushWriteChunk True                     ' write out the tail, surrogate and all
                If mHandle <> 0 Then
                    CloseHandle mHandle
                    mHandle = 0
                End If
            Else
                If mFile <> 0 Then
                    Close #mFile
                    mFile = 0
                End If
            End If
        Else
            FlushBuffered                                ' the buffered path's ONLY disk write
        End If
        mClosed = True
    End Sub

    ' Safety net for a caller who drops the reference without calling Close - without
    ' it, a streamed write would lose its unflushed tail and a buffered write would
    ' never reach disk at all. Mirrors Close's body deliberately rather than calling
    ' it, since raising out of a Terminate is not an option (hence the blanket
    ' On Error Resume Next).
    Private Sub Class_Terminate()
        On Error Resume Next
        If Not mClosed And Not mIsStd Then
            If mStreaming Then
                If mMode <> ForReading Then
                    FlushWriteChunk True
                    If mHandle <> 0 Then CloseHandle mHandle
                Else
                    If mFile <> 0 Then Close #mFile
                End If
            Else
                FlushBuffered
            End If
        End If
    End Sub

    '======================================================================
    ' Properties
    '======================================================================
    ' NOT a pure query in streaming mode: it has to pull a chunk to find out whether
    ' anything is left, so it can advance the file position and grow mDecoded. That
    ' is harmless (nothing is consumed - mDecPos does not move), but it does mean
    ' this property can raise the same I/O errors a read can.
    [Description("True when the read cursor is at end of stream.")]
    Public Property Get AtEndOfStream() As Boolean
        If mIsStd Then AtEndOfStream = StdAtEnd(): Exit Property
        EnsureReadable
        If mStreaming Then
            If Available() > 0 Then Exit Property        ' fast path: text in hand, definitely not EOS
            Do While Available() = 0
                If Not FillSome() Then Exit Do           ' loop: FillSome can progress without decoding
            Loop
            AtEndOfStream = (Available() = 0)
        Else
            AtEndOfStream = (mPos > Len(mBuffer))
        End If
    End Property

    ' Peeks one character without consuming it. Same fill caveat as AtEndOfStream.
    ' False at end of stream (there is no character there to be a terminator).
    [Description("True when the next character to read is a line terminator (CR or LF).")]
    Public Property Get AtEndOfLine() As Boolean
        If mIsStd Then AtEndOfLine = StdAtEndOfLine(): Exit Property
        EnsureReadable
        If mStreaming Then
            Do While Available() = 0
                If Not FillSome() Then Exit Do
            Loop
            If Available() = 0 Then Exit Property         ' end of stream
            Dim c As Long
            c = AscW(Mid$(mDecoded, mDecPos, 1)) And &HFFFF&
            AtEndOfLine = (c = 13 Or c = 10)
        Else
            If mPos > Len(mBuffer) Then Exit Property
            Dim c2 As Long
            c2 = AscW(Mid$(mBuffer, mPos, 1)) And &HFFFF&
            AtEndOfLine = (c2 = 13 Or c2 = 10)
        End If
    End Property

    ' Line/Column track everything that has passed through AdvancePosition - which
    ' includes WRITES, not just reads (FSO parity).
    [Description("Current 1-based line number.")]
    Public Property Get Line() As Long
        Line = mLine
    End Property

    [Description("Current 1-based column number.")]
    Public Property Get Column() As Long
        Column = mColumn
    End Property

    ' Signed: negative means the file carries a BOM (see the TextCodec sign
    ' convention). For a read this is the DETECTED encoding, so it is the value to
    ' inspect when a file decodes to garbage.
    [Description("The resolved encoding of the stream (auto-detected for reads when not specified). BOM-bearing encodings report as their negative (e.g. encUtf8Bom).")]
    Public Property Get Encoding() As TextEncoding
        Encoding = mEnc
    End Property
    
    ' Diagnostic: False means Classify() found no chunk-boundary rule for this code
    ' page and the whole file is sitting in memory. Expect it only for UTF-7 and
    ' exotic MBCS pages.
    [Description("True if the stream uses byte-streaming; False if it fell back to a buffered (whole-file) path.")]
    Public Property Get IsStreaming() As Boolean
        IsStreaming = mStreaming
    End Property

    '======================================================================
    ' Helpers
    '======================================================================
    ' The three guards. Error numbers follow FSO: 52 for a closed stream, 54 for a
    ' mode mismatch. Note EnsureWritable accepts anything that is not ForReading,
    ' i.e. both ForWriting and ForAppending.
    Private Sub EnsureOpen()
        If mClosed Then Err.Raise 52, "TextStream", "Operation on a closed stream"
    End Sub

    Private Sub EnsureReadable()
        EnsureOpen
        If mMode <> ForReading Then Err.Raise 54, "TextStream", "Stream is not open for reading"
    End Sub

    Private Sub EnsureWritable()
        EnsureOpen
        If mMode = ForReading Then Err.Raise 54, "TextStream", "Stream is not open for writing"
    End Sub

    Private Function IsCharCR(ByRef text As String, ByVal pos As Long) As Boolean
        IsCharCR = ((AscW(Mid$(text, pos, 1)) And &HFFFF&) = 13)
    End Function

    ' Finds the next CR/LF at or after startPos in text. Returns its 1-based
    ' position and sets breakLen to 1 (CR or LF) or 2 (CRLF).
    '
    ' Handles all three conventions in one pass, which is why a mixed-newline file
    ' reads correctly line by line. The only case it cannot resolve alone is a CR at
    ' the very end of the buffer - it reports breakLen 1, and ReadLine is responsible
    ' for pulling more bytes before trusting that (see its fill loop).
    Private Function NextLineBreakIn(ByRef text As String, ByVal startPos As Long, ByRef breakLen As Long) As Long
        Dim pCR As Long, pLF As Long, p As Long
        pCR = InStr(startPos, text, vbCr)
        pLF = InStr(startPos, text, vbLf)

        If pCR = 0 And pLF = 0 Then
            breakLen = 0
            NextLineBreakIn = 0
            Exit Function
        End If

        If pCR = 0 Then
            p = pLF: breakLen = 1
        ElseIf pLF = 0 Then
            p = pCR: breakLen = 1
        ElseIf pCR < pLF Then
            p = pCR
            If pLF = pCR + 1 Then breakLen = 2 Else breakLen = 1   ' CRLF vs lone CR
        Else
            p = pLF: breakLen = 1                                 ' LF before any CR
        End If
        NextLineBreakIn = p
    End Function

    ' Advances mLine/mColumn over the consumed/written text. CRLF counts as ONE break.
    '
    ' Uses native InStr/InStrRev scans rather than walking code units: a few passes of
    ' compiled string search beat a per-unit VB loop by orders of magnitude (measured:
    ' 3.1x faster on a 2.4GB write), and it avoids copying the string to a Byte() just
    ' to count. Len() counts UTF-16 code units, which is the same unit the old loop
    ' used - so a surrogate pair still counts as two columns, exactly as before.
    '
    ' KNOWN QUIRK (pre-existing, pinned by AdvancePositionTests): a CRLF split across
    ' two calls counts as TWO breaks, since there is no state between calls. The read
    ' path cannot hit this - ReadLine always hands over a complete terminator.
    Private Sub AdvancePosition(ByRef consumed As String)
        Dim n As Long
        n = Len(consumed)
        If n = 0 Then Exit Sub

        ' lines = every CR + every LF that isn't part of a CRLF.
        ' (nCR + nLF - nCRLF: the CRLF pair is counted once, not twice.)
        Dim lines As Long
        lines = CountOf(consumed, vbCr) + CountOf(consumed, vbLf) - CountOf(consumed, vbCrLf)

        If lines = 0 Then
            mColumn = mColumn + n
            Exit Sub
        End If

        ' Column = whatever follows the LAST break. For a CRLF the LF is the later of
        ' the two, so taking the max of the two InStrRev results lands correctly on the
        ' end of the pair.
        Dim pCR As Long, pLF As Long, lastBreakEnd As Long
        pCR = InStrRev(consumed, vbCr)
        pLF = InStrRev(consumed, vbLf)
        If pLF > pCR Then lastBreakEnd = pLF Else lastBreakEnd = pCR

        mLine = mLine + lines
        mColumn = (n - lastBreakEnd) + 1
    End Sub

    ' Non-overlapping occurrence count. Binary compare: locale-independent and faster.
    Private Function CountOf(ByRef s As String, ByVal find As String) As Long
        Dim p As Long, fl As Long, n As Long
        fl = Len(find)
        p = InStr(1, s, find, vbBinaryCompare)
        Do While p > 0
            n = n + 1
            p = InStr(p + fl, s, find, vbBinaryCompare)
        Loop
        CountOf = n
    End Function
    
    '======================================================================
    ' OpenStandardStream helpers
    '
    ' Mode 3. The source is a Win32 handle we do NOT own, so: no Seek, no size, no
    ' Close, and reads block until the OS hands something back. The decode pipeline
    ' is the same shape as the file one (raw carry -> complete prefix -> decode ->
    ' text buffer), just driven by ReadFile instead of Get.
    '
    ' CAVEATS worth knowing before debugging something odd here:
    '   * mMode is never set (stays 0), so the Ensure* guards are effectively
    '     bypassed - each Std* helper does its own direction check instead.
    '   * Only the members with an "If mIsStd Then ..." first line support this
    '     mode; the rest are file-only.
    '   * Close does not close the handle (the process owns it) but DOES mark the
    '     object closed, so further use raises 52 like any other stream.
    '======================================================================
    Friend Sub InitStdStream(ByVal handle As LongPtr, ByVal isInput As Boolean, ByVal wide As Boolean)
        mIsStd = True
        mStdHandle = handle
        mStdInput = isInput
        If wide Then mStdCp = encUtf16 Else mStdCp = encSystemAnsi   ' both are non-negative => usable as a CP
        mLineEnding = vbCrLf  ' console convention; not caller-configurable
        mLine = 1             ' Init() never runs on this path - seed them here
        mColumn = 1
        mStdInBuf = vbNullString
        mStdEof = False
        Erase mStdRaw
        If isInput Then Classify mStdCp, mStdKind, mStdLead   ' only reads need boundary math
    End Sub

    Private Sub StdEnsureInput()
        If Not mStdInput Then Err.Raise 54, "TextStream", "Stream is not open for reading."
    End Sub

    ' No BOM, ever - a console/pipe consumer does not want one mid-stream. Wide mode
    ' emits raw UTF-16LE units, which is what the W console APIs expect.
    Private Sub StdWriteString(ByVal text As String)
        If mStdInput Then Err.Raise 54, "TextStream", "Stream is not open for writing."
        If Len(text) = 0 Then Exit Sub
        Dim bytes() As Byte
        bytes = TextCodec.EncodeBytes(text, mStdCp)
        If Not IsArrayInitialized(bytes) Then Exit Sub
        Dim written As Long
        WriteFile mStdHandle, bytes(0), UBound(bytes) - LBound(bytes) + 1, written, ByVal vbNullPtr
        AdvancePosition text          ' writes move Line/Column too (FSO parity)
    End Sub

    ' Pull one OS read, decode only the complete-character prefix, carry the remainder.
    '
    ' The file reader knows how many bytes are left; here we do not, so EOF is
    ' inferred from ReadFile (a zero-byte or failed read) and latched in mStdEof.
    ' A short read is normal on a pipe/console and is NOT end of input.
    ' NOTE this can return having decoded nothing (partial character, or a read that
    ' returned only continuation bytes) - the callers all loop on a condition.
    Private Sub StdFill(ByVal wantBytes As Long)
        If Not mStdEof Then
            Dim raw() As Byte, got As Long, ok As Long
            ReDim raw(wantBytes - 1)
            ok = ReadFile(mStdHandle, raw(0), wantBytes, got, ByVal vbNullPtr)
            If ok = 0 Or got = 0 Then
                mStdEof = True                       ' failed or zero-length read: latch EOF
            Else
                ReDim Preserve raw(got - 1)          ' shrink to what actually arrived
                mStdRaw = TextCodec.ConcatBytes(mStdRaw, raw)
            End If
        End If

        Dim total As Long, n As Long
        total = TextCodec.SafeCountB(mStdRaw)
        If total = 0 Then Exit Sub
        ' At EOF, decode whatever is left (a partial tail is truncated input, not a
        ' boundary artifact) - same reasoning as ReadAll's final block.
        If mStdEof Then n = total Else n = CompletePrefixLen(mStdRaw, total, mStdKind, mStdLead)
        If n <= 0 Then Exit Sub                      ' not one whole character yet; carry it all

        Dim head() As Byte
        head = TextCodec.SliceBytes(mStdRaw, 0, n - 1)
        mStdInBuf = mStdInBuf & TextCodec.DecodeBytes(head, mStdCp, nlNoChange)
        If n < total Then mStdRaw = TextCodec.SliceBytes(mStdRaw, n, total - 1) Else Erase mStdRaw
    End Sub

    ' Blocks until the source closes (Ctrl+Z / EOF on a pipe).
    Private Function StdReadAll() As String
        StdEnsureInput
        Do
            StdFill 65536
        Loop While Not mStdEof
        StdReadAll = mStdInBuf: mStdInBuf = vbNullString
        AdvancePosition StdReadAll
    End Function

    ' Splits on LF and strips a preceding CR, so it handles both CRLF and bare-LF
    ' input. Simpler than the file reader's ReadLine because the CR can never be
    ' orphaned at a chunk boundary here - we only ever look for the LF.
    ' At EOF with no trailing LF, the remainder is returned as the final line.
    Private Function StdReadLine() As String
        StdEnsureInput
        Dim p As Long
        Do
            p = InStr(mStdInBuf, vbLf)
            If p > 0 Then Exit Do
            If mStdEof Then Exit Do
            StdFill 4096
        Loop
        If p > 0 Then
            Dim ln As String
            ln = Left$(mStdInBuf, p - 1)
            mStdInBuf = Mid$(mStdInBuf, p + 1)
            If Len(ln) > 0 AndAlso Right$(ln, 1) = vbCr Then ln = Left$(ln, Len(ln) - 1)
            StdReadLine = ln
            ' The terminator was consumed but is not in the return value - AdvancePosition
            ' must still see one, or the line counter never moves. A bare LF is enough:
            ' CRLF and LF both count as exactly one break.
            AdvancePosition ln & vbLf
        Else
            StdReadLine = mStdInBuf: mStdInBuf = vbNullString
            AdvancePosition StdReadLine        ' EOF, unterminated final line: no break
        End If
    End Function

    ' Short read at EOF rather than an error (unlike the file Read, which raises 62).
    Private Function StdReadChars(ByVal n As Long) As String
        StdEnsureInput
        Do While Len(mStdInBuf) < n And Not mStdEof
            StdFill 4096
        Loop
        If n >= Len(mStdInBuf) Then
            StdReadChars = mStdInBuf: mStdInBuf = vbNullString
        Else
            StdReadChars = Left$(mStdInBuf, n)
            mStdInBuf = Mid$(mStdInBuf, n + 1)
        End If
        AdvancePosition StdReadChars
    End Function

    ' Blocking: on an interactive console this waits for input before it can say
    ' "no more input". Both conditions are required - buffer empty AND EOF latched.
    Private Function StdAtEnd() As Boolean
        StdEnsureInput
        If Len(mStdInBuf) > 0 Then Exit Function
        If Not mStdEof Then StdFill 4096
        StdAtEnd = (Len(mStdInBuf) = 0) And mStdEof
    End Function

    ' Peeks the next decoded character without consuming it. Blocks if nothing is
    ' buffered yet, for the same reason StdAtEnd does. False at end of input - there
    ' is no character there to be a terminator.
    Private Function StdAtEndOfLine() As Boolean
        StdEnsureInput
        If Len(mStdInBuf) = 0 And Not mStdEof Then StdFill 4096
        If Len(mStdInBuf) = 0 Then Exit Function
        Dim c As Long
        c = AscW(Left$(mStdInBuf, 1)) And &HFFFF&
        StdAtEndOfLine = (c = 13 Or c = 10)
    End Function
    
    '======================================================================
    ' Streamability classification + chunk-boundary math
    '
    ' Classify() answers "can this code page be chunked at all?" once, at open.
    ' CompletePrefixLen() then answers "where does the last WHOLE character end in
    ' this chunk?" on every fill. Everything the *PrefixLen helpers return is a byte
    ' count from the START of the buffer; the remainder becomes the carry.
    '
    ' The universal rule for these helpers: when in doubt, return LESS. Under-
    ' reporting merely defers bytes to the next chunk; over-reporting splits a
    ' character and corrupts the text.
    '======================================================================
    ' Classifies a code page for chunked streaming. Returns True and sets kind (and DBCS lead-byte ranges) when streamable; False when it must be buffered. cpANSI is resolved to the real ACP via GetACP/GetCPInfo.
    Private Function Classify(ByVal codePage As Long, ByRef kind As DecodeKind, ByRef leadRanges() As Byte) As Boolean
        Select Case codePage
            ' --- Known-shape encodings: decided by inspection, no API needed ---
            Case encUtf8
                kind = dkUtf8: Classify = True
            Case encUtf16
                kind = dkUtf16LE: Classify = True
            Case encUtf16Be
                kind = dkUtf16BE: Classify = True
            Case encUtf32, encUtf32Be
                kind = dkUtf32: Classify = True      ' endianness is irrelevant to a fixed 4-byte unit
            Case encUsAscii, encLatin1, encLatin9
                kind = dkSingle: Classify = True
            Case encGB18030
                kind = dkGB18030: Classify = True
            Case encUtf7
                Classify = False                      ' stateful - not chunk-safe
            Case Else
                ' --- Anything else: ask Windows about it ---
                ' encSystemAnsi (0) is a placeholder, not a real page - resolve it to
                ' the machine's actual ACP first, which may itself be UTF-8 or DBCS.
                Dim realCp As Long
                If codePage = encSystemAnsi Then realCp = GetACP() Else realCp = codePage
                Select Case realCp
                    Case encUtf8
                        kind = dkUtf8: Classify = True
                    Case encGB18030
                        kind = dkGB18030: Classify = True
                    Case Else
                        Dim info As CPINFO
                        If GetCPInfo(realCp, info) = 0 Then
                            Classify = False          ' unknown page: cannot reason about boundaries
                        ElseIf info.MaxCharSize = 1 Then
                            kind = dkSingle: Classify = True
                        ElseIf info.MaxCharSize = 2 Then
                            ' DBCS: the lead-byte ranges are the only thing that tells
                            ' us whether a given byte starts a 2-byte character, so
                            ' copy them out of CPINFO for IsDbcsLead to consult.
                            Dim k As Long
                            ReDim leadRanges(0 To 11)
                            For k = 0 To 11
                                leadRanges(k) = info.LeadByte(k)
                            Next
                            kind = dkDBCS: Classify = True
                        Else
                            Classify = False          ' >2 bytes and not a shape we know: buffer it
                        End If
                End Select
        End Select
    End Function

    ' Number of bytes from the start of b() that form whole characters for the given kind. The remainder (an incomplete trailing sequence) must be carried to the next chunk.
    ' Pure dispatch - one arm per DecodeKind. dkSingle needs no work (every byte is a
    ' complete character), which is why it is the Else.
    Private Function CompletePrefixLen(ByRef b() As Byte, ByVal total As Long, ByVal kind As DecodeKind, ByRef leadRanges() As Byte) As Long
        Select Case kind
            Case dkUtf8:     CompletePrefixLen = Utf8PrefixLen(b, total)
            Case dkUtf16LE:  CompletePrefixLen = Utf16PrefixLen(b, total, True)
            Case dkUtf16BE:  CompletePrefixLen = Utf16PrefixLen(b, total, False)
            Case dkUtf32:    CompletePrefixLen = total - (total Mod 4)   ' fixed width: just round down
            Case dkDBCS:     CompletePrefixLen = DbcsPrefixLen(b, total, leadRanges)
            Case dkGB18030:  CompletePrefixLen = Gb18030PrefixLen(b, total)
            Case Else:       CompletePrefixLen = total            ' dkSingle
        End Select
    End Function

    ' UTF-8 is self-synchronizing, so we only need to inspect the TAIL: walk back
    ' over continuation bytes (10xxxxxx) to the last lead byte, ask how many bytes
    ' that lead needs, and cut the sequence off if the buffer cannot supply them.
    ' O(1)-ish rather than a full scan - the walk-back is at most 3 bytes in valid
    ' input. An invalid lead is treated as need=1 so garbage cannot stall the reader.
    Private Function Utf8PrefixLen(ByRef b() As Byte, ByVal total As Long) As Long
        Dim i As Long
        i = total - 1
        Do While i >= 0
            If (b(i) And &HC0) = &H80 Then i = i - 1 Else Exit Do    ' 10xxxxxx = continuation
        Loop
        If i < 0 Then
            Utf8PrefixLen = total                ' all continuation bytes (garbage): don't stall, take it
            Exit Function
        End If

        Dim lead As Long, need As Long
        lead = b(i)
        If (lead And &H80) = 0 Then
            need = 1                             ' 0xxxxxxx
        ElseIf (lead And &HE0) = &HC0 Then
            need = 2                             ' 110xxxxx
        ElseIf (lead And &HF0) = &HE0 Then
            need = 3                             ' 1110xxxx
        ElseIf (lead And &HF8) = &HF0 Then
            need = 4                             ' 11110xxx
        Else
            need = 1                             ' invalid lead: treat as a 1-byte unit
        End If

        ' (total - i) is how many bytes we actually HAVE for that final sequence.
        If (total - i) < need Then Utf8PrefixLen = i Else Utf8PrefixLen = total
    End Function

    ' Two things can straddle a UTF-16 chunk boundary: half a code unit (odd byte
    ' count) and half a surrogate pair. Round down to whole units, then drop a
    ' trailing HIGH surrogate so its low half stays with it in the next chunk.
    Private Function Utf16PrefixLen(ByRef b() As Byte, ByVal total As Long, ByVal isLE As Boolean) As Long
        Dim complete As Long
        complete = total - (total Mod 2)         ' whole code units only
        If complete >= 2 Then
            Dim hi As Long, lo As Long, unit As Long
            If isLE Then
                lo = b(complete - 2): hi = b(complete - 1)
            Else
                hi = b(complete - 2): lo = b(complete - 1)
            End If
            unit = (hi * &H100&) Or lo
            If unit >= &HD800& And unit <= &HDBFF& Then complete = complete - 2   ' lone high surrogate
        End If
        Utf16PrefixLen = complete
    End Function

    ' DBCS has no self-synchronization: a trail byte is indistinguishable from a lead
    ' byte out of context, so the ONLY way to know whether the last byte starts a
    ' character is to walk the whole buffer from the front. Hence the full scan (and
    ' why this is the slowest of the boundary helpers).
    Private Function DbcsPrefixLen(ByRef b() As Byte, ByVal total As Long, ByRef leadRanges() As Byte) As Long
        Dim i As Long
        i = 0
        Do While i < total
            If IsDbcsLead(b(i), leadRanges) Then
                If i = total - 1 Then
                    DbcsPrefixLen = i        ' trailing lead byte awaits its trail
                    Exit Function
                End If
                i = i + 2                    ' lead + trail
            Else
                i = i + 1                    ' single byte
            End If
        Loop
        DbcsPrefixLen = total
    End Function

    ' CPINFO.LeadByte is 6 lo/hi pairs, terminated early by a 0,0 pair. Unused pairs
    ' are zeroed, so the 0,0 test is the list terminator, not a valid range.
    Private Function IsDbcsLead(ByVal bb As Long, ByRef leadRanges() As Byte) As Boolean
        Dim k As Long, lo As Long, hi As Long
        For k = 0 To 10 Step 2
            lo = leadRanges(k)
            hi = leadRanges(k + 1)
            If lo = 0 And hi = 0 Then Exit Function      ' end of the range list
            If bb >= lo And bb <= hi Then
                IsDbcsLead = True
                Exit Function
            End If
        Next
    End Function

    ' GB18030 is 1, 2 or 4 bytes, and the width is only decidable from the SECOND
    ' byte: a lead of 81-FE followed by a digit (30-39) means a 4-byte sequence,
    ' otherwise 2. So, like DBCS, this needs a full forward scan - and it has two
    ' distinct "ran out of bytes" exits, one per width.
    Private Function Gb18030PrefixLen(ByRef b() As Byte, ByVal total As Long) As Long
        Dim i As Long, b1 As Long, b2 As Long
        i = 0
        Do While i < total
            b1 = b(i)
            If b1 <= &H7F Then
                i = i + 1                            ' ASCII
            ElseIf b1 >= &H81 And b1 <= &HFE Then
                If i + 1 >= total Then
                    Gb18030PrefixLen = i             ' lead byte, no second byte yet: carry it
                    Exit Function
                End If
                b2 = b(i + 1)
                If b2 >= &H30 And b2 <= &H39 Then    ' digit second byte => 4-byte form
                    If i + 3 >= total Then
                        Gb18030PrefixLen = i         ' 4-byte sequence is incomplete: carry it
                        Exit Function
                    End If
                    i = i + 4
                Else
                    i = i + 2                        ' 2-byte form
                End If
            Else
                i = i + 1                            ' &H80 / &HFF: not a valid lead; skip one
            End If
        Loop
        Gb18030PrefixLen = total
    End Function
    
    ' Raises 52 if the LEAF of a create path has illegal filename chars. Used only
    ' for CREATE (an existing file can't have an illegal name). Validating up front
    ' keeps the error identical (FSO's 52) regardless of which open path is taken.
    ' Colon is EXCLUDED: a direct write to "<file>:<stream>" is a valid ADS write
    ' that FSO (and we) succeed on (oracle: bad:colon -> 0). Leaf-only.
    '
    ' Contrast FileSystemTools.GuardWriteName, which DOES reject the colon: that path
    ' goes through WriteStream's temp-file swap, which cannot express an ADS write.
    ' The two guards differ by exactly that one character, on purpose.
    Private Sub GuardCreateName(ByVal path As String, ByVal opName As String)
        Dim leaf As String
        leaf = FileSystemTools.GetFileName(path)
        If leaf Like "*[<>""|?*]*" Then           ' NO colon: ':' in a leaf is a valid ADS write
            Err.Raise 52, opName, "Bad file name or number: " & path
        End If
        ' Control chars aren't expressible in a Like pattern - check them separately.
        Dim i As Long
        For i = 1 To Len(leaf)
            If AscW(Mid$(leaf, i, 1)) < 32 Then
                Err.Raise 52, opName, "Bad file name or number: " & path
            End If
        Next
    End Sub
    
End Class
