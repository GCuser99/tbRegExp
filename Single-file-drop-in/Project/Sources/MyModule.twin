Module MyModule

    Sub test()
        Dim re As New RegExp
        Dim mc As MatchCollection
        Dim m As Match
        Dim sm As String
        
        re.Pattern = "文(言)文与"
        Debug.Assert re.Test("1234文言文与1235")
        Set mc = re.Execute("1234文言文与1235")
        For Each m In mc
            Debug.Assert m.Value = "文言文与"
            For Each sm In m.SubMatches
                Debug.Assert sm = "言"
            Next sm
        Next m
    End Sub

End Module