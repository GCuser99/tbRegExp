[Description("")]
[FormDesignerId("EAEAEAEA-EAEA-EAEA-EAEA-EAEAEAEAEA01")]
[PredeclaredId]
Class Form1

    Sub New()
    End Sub
    
    Private Sub btnRunBenchmarks_Click()
        Dim path As String
        path = modBench.RunSuite()
        If Len(path) > 0 Then
            MsgBox "Benchmarks complete." & vbCrLf & vbCrLf & _
                   "Report: " & path & vbCrLf & _
                   "(CSV alongside, same folder)", vbInformation
        Else
            MsgBox "Ran, but the report file couldn't be written — check TEMP permissions.", vbExclamation
        End If
        path = modBench.RunDiagnostic
        If Len(path) > 0 Then
            MsgBox "Diagnostic complete." & vbCrLf & vbCrLf & _
                   "Report: " & path & vbCrLf & _
                   "(CSV alongside, same folder)", vbInformation
        Else
            MsgBox "Ran, but the report file couldn't be written — check TEMP permissions.", vbExclamation
        End If
    End Sub
    
End Class