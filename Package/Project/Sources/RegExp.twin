' ==========================================================================
' See https://github.com/GCuser99/tbRegExp for more info.
' ==========================================================================
' ==========================================================================
'  tbRegExp - a drop-in replacement for VBScript.RegExp.
'
'  Classes: RegExp, Match, MatchCollection, SubMatches. Pure twinBASIC, with
'  no dependency beyond the StaticRegex module in this package, which holds
'  the matching engine - sihlfall's excellent vba-regex, with fixes:
'  https://github.com/sihlfall/vba-regex
'
'  Code written against VBScript.RegExp should run unchanged, quirks included:
'  where the two engines could differ, this one follows VBScript rather than
'  ECMAScript. It also offers what VBScript does not - DotAll, Split, named
'  groups, lookbehind, inline modifiers, $<name> replacement, and checking a
'  pattern without raising.
'
'  One behaviour VBScript has no equivalent for: a search is given a step
'  budget that scales with the length of the string, so a pattern that
'  backtracks catastrophically gives up after a few seconds rather than
'  hanging. The result is then a "no match" that is not an answer, and
'  SearchAborted is True.
'
'  Contact: https://github.com/GCUser99
' ==========================================================================
[PredeclaredId(False)]
[Hidden(False)]
[Description("This class exposes a drop-in replacement for VBSript's regular expressions object model.")]
Public Class RegExp
    Option Explicit
    ' ==========================================================================
    ' MIT License
    '
    ' Copyright (c) 2025-2026, GCUser99
    '
    ' Permission is hereby granted, free of charge, to any person obtaining a copy
    ' of this software and associated documentation files (the "Software"), to deal
    ' in the Software without restriction, including without limitation the rights
    ' to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
    ' copies of the Software, and to permit persons to whom the Software is
    ' furnished to do so, subject to the following conditions:
    '
    ' The above copyright notice and this permission notice shall be included in all
    ' copies or substantial portions of the Software.
    '
    ' THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
    ' IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
    ' FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
    ' AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
    ' LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
    ' OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
    ' SOFTWARE.
    ' ==========================================================================

    Private mGlobal As Boolean
    Private mMultiLine As Boolean
    Private mIgnoreCase As Boolean
    Private mPattern As String
    Private mDotAll As Boolean
    ' IsValid/LastError: compile state
    Private mCompileAttempted As Boolean
    Private mIsValid As Boolean
    Private mLastError As String
    Private mLastErrNumber As Long
    Private mSearchAborted As Boolean   '>>> PATCH 18: per-instance, see SearchAborted

    ' Named-capture map and capture count, cached per compiled Pattern. Both are
    ' pure functions of the bytecode, so they are computed once in EnsureCompiled
    ' rather than rebuilt on every Execute call.
    Private mCapNames() As String       ' 0-based, one entry per DISTINCT named capture
    Private mCapEntryPoints() As Long   ' parallel: identifier id, indexes namedCaptures()
    Private mNamedCount As Long         ' = bytecode(BYTECODE_IDX_N_IDENTIFIERS)
    Private mNumCaptures As Long        ' = number of numbered capture groups

    Private regex As StaticRegex.RegexTy

    [Description("Sets or Gets the options in use: g-global; m-multiline; i-ignore case; s-dot all. Example: 'gm' sets Global and MultiLine to 'True', IgnoreCase and DotAll to 'False'.")]
    Public Property Let Flags(ByVal pFlags As String)
        ' Note that if a flag indicator is not present in the string, then it is set to False
        ' Setting Flags value to vbNullString effectively sets all flags to False (default state)
        pFlags = LCase(pFlags)
        mGlobal = CBool(InStr(pFlags, "g"))
        mMultiLine = CBool(InStr(pFlags, "m"))
        IgnoreCase = CBool(InStr(pFlags, "i")) ' assign via the property (not mIgnoreCase) so its recompile-on-change side effect fires
        mDotAll = CBool(InStr(pFlags, "s"))
    End Property
    Public Property Get Flags() As String
        If mGlobal Then Flags = Flags & "g"
        If mMultiLine Then Flags = Flags & "m"
        If mIgnoreCase Then Flags = Flags & "i"
        If mDotAll Then Flags = Flags & "s"
    End Property

    [Description("If 'True', all matches will be returned. If 'False', only the first match will be returned. Defaults to 'False'")]
    Public Property Let Global(ByVal pGlobal As Boolean)
        mGlobal = pGlobal
    End Property
    Public Property Get Global() As Boolean
        Global = mGlobal
    End Property

    [Description("If 'True', '^' pattern will match the beginning of a line after a new line character and '$' will match the end of a line before a new line character. If 'False' (default), '^' will match the beginning of the entire string and '$' will match the end of the entire string.")]
    Public Property Let MultiLine(ByVal pMultiLine As Boolean)
        mMultiLine = pMultiLine
    End Property
    Public Property Get MultiLine() As Boolean
        MultiLine = mMultiLine
    End Property

    [Description("If 'True', '.' pattern will match across new line charactors. Defaults to 'False'")]
    Public Property Let DotAll(ByVal pDotAll As Boolean)
        mDotAll = pDotAll
    End Property
    Public Property Get DotAll() As Boolean
        DotAll = mDotAll
    End Property

    [Description("If 'True', matches will be case-insensitive. If 'False', matches will be case-sensitive. Defaults to 'False'")]
    Public Property Let IgnoreCase(ByVal pIgnoreCase As Boolean)
        If pIgnoreCase <> mIgnoreCase Then
            mIgnoreCase = pIgnoreCase
            mCompileAttempted = False
        End If
    End Property
    Public Property Get IgnoreCase() As Boolean
        IgnoreCase = mIgnoreCase
    End Property

    [Description("The regular expression pattern.")]
    Public Property Let Pattern(ByVal pPattern As String)
        If pPattern <> mPattern Then
            mPattern = pPattern
            mCompileAttempted = False
        End If
    End Property
    Public Property Get Pattern() As String
        Pattern = mPattern
    End Property

    [Description("Returns a MatchCollection. Uses the Pattern property to search the sourceString.")]
    Public Function Execute(ByVal sourceString As String) As MatchCollection
        Dim matcherState As StaticRegex.MatcherStateTy
        Dim oMatches As MatchCollection
        Dim oMatch As Match
        Dim i As Long
        Dim matchStart As Long, matchLength As Long

        mSearchAborted = False                  '>>> PATCH 18
        EnsureCompiled
        If Not mIsValid Then Err.Raise mLastErrNumber, "RegExp", mLastError

        StaticRegex.ClearStepsLimitHit          '>>> PATCH 18
        StaticRegex.InitializeMatcherState matcherState, Not mGlobal, mMultiLine, mDotAll

        Set oMatches = New MatchCollection

        Do While StaticRegex.MatchNext(matcherState, regex, sourceString)

            With matcherState.captures
                Dim mValue As String, mFirst As Long, mLen As Long
                matchStart = .entireMatch.start
                matchLength = .entireMatch.Length
                If matchStart > 0 Then
                    mValue = Mid$(sourceString, matchStart, matchLength)
                    mFirst = matchStart - 1          ' zero-based, matches VBScript_RegExp_55
                    mLen = matchLength
                Else
                    mValue = vbNullString
                    mFirst = 0
                    mLen = 0
                End If

                Dim subVals() As String, subKeys() As String
                Dim n As Long
                n = .nNumberedCaptures

                If n > 0 Then
                    ReDim subVals(0 To n - 1)
                    ReDim subKeys(0 To n - 1)       ' vbNullString by default = unnamed

                    ' name the slots (single pass over distinct named captures)
                    If mNamedCount > 0 Then
                        Dim referenced As Long
                        For i = 0 To mNamedCount - 1
                            referenced = .namedCaptures(mCapEntryPoints(i))
                            If referenced <> -1 Then subKeys(referenced - 1) = mCapNames(i)
                        Next i
                    End If

                    ' fill the values (single pass over numbered captures)
                    For i = 0 To n - 1
                        matchStart = .numberedCaptures(i).start
                        matchLength = .numberedCaptures(i).Length
                        If matchStart > 0 Then
                            subVals(i) = Mid$(sourceString, matchStart, matchLength)
                        Else
                            subVals(i) = vbNullString
                        End If
                    Next i
                End If

                Set oMatch = New Match
                oMatch.Internal_Init mValue, mFirst, mLen, subVals, subKeys, n
                oMatches.Internal_Add oMatch
            End With
        Loop
        mSearchAborted = StaticRegex.StepsLimitHit()    '>>> PATCH 18
        Set Execute = oMatches
    End Function

    [Description("Returns 'True' if Pattern finds a match in sourceString, otherwise returns 'False'.")]
    Public Function Test(ByVal sourceString As String) As Boolean
        mSearchAborted = False                  '>>> PATCH 18
        EnsureCompiled
        If Not mIsValid Then Err.Raise mLastErrNumber, "RegExp", mLastError
        StaticRegex.ClearStepsLimitHit          '>>> PATCH 18
        Test = StaticRegex.Test(regex, sourceString, mMultiLine, mDotAll)
        mSearchAborted = StaticRegex.StepsLimitHit()    '>>> PATCH 18
    End Function

    [Description("Replaces matches with replaceString and returns the String with replacements made.")]
    Public Function Replace(ByVal sourceString As String, ByVal replaceString As String) As String
        mSearchAborted = False                  '>>> PATCH 18
        EnsureCompiled
        If Not mIsValid Then Err.Raise mLastErrNumber, "RegExp", mLastError
        StaticRegex.ClearStepsLimitHit          '>>> PATCH 18
        Replace = StaticRegex.ReplaceByRegEx(regex, replaceString, sourceString, Not mGlobal, mMultiLine, mDotAll)
        mSearchAborted = StaticRegex.StepsLimitHit()    '>>> PATCH 18
    End Function

    [Description("Splits an input string into an array of substrings at the positions defined by a regular expression match. Needs Global Property set to 'True'.")]
    Public Function Split(ByVal sourceString As String) As Collection
        mSearchAborted = False                  '>>> PATCH 18
        EnsureCompiled
        If Not mIsValid Then Err.Raise mLastErrNumber, "RegExp", mLastError
        StaticRegex.ClearStepsLimitHit          '>>> PATCH 18
        Set Split = StaticRegex.SplitByRegex(regex, sourceString, Not mGlobal, mMultiLine, mDotAll)
        mSearchAborted = StaticRegex.StepsLimitHit()    '>>> PATCH 18
    End Function

    [Description("Returns True if the current Pattern compiles successfully; False if it is invalid. Does not raise.")]
    Public Property Get IsValid() As Boolean
        EnsureCompiled
        IsValid = mIsValid
    End Property

    [Description("Returns the compile error message for the current Pattern, or an empty string if the Pattern is valid.")]
    Public Property Get LastError() As String
        EnsureCompiled
        LastError = mLastError
    End Property

    [Description("Returns the compile error number for the current Pattern, or 0 if the Pattern is valid.")]
    Public Property Get LastErrorNumber() As Long
        EnsureCompiled
        LastErrorNumber = mLastErrNumber
    End Property

    '>>> PATCH 18: the one thing the step budget has to surface.
    '
    ' There is deliberately NO public way to set the budget. "Steps" is a unit of
    ' sihlfall's DFS matcher rather than a stable concept, so publishing it would
    ' commit us to a number whose meaning changes if the matcher does; and since
    ' the budget now scales itself with the input (PATCH 19 in StaticRegex), the
    ' only thing a setter could achieve is to make it wrong again. RegexTy.stepsLimit
    ' survives for anyone driving the StaticRegex module directly.
    '
    ' This flag is not optional, though. A budget that runs out reports "no match",
    ' which is a silent wrong answer - and it is reachable on a 30-character string
    ' given a pattern like "(a+)+b". VBScript.RegExp hangs on that same input, which
    ' is worse but at least visible. This is how a caller tells the two apart.
    '
    ' SEARCH, not match: the budget is spent across the whole call, over every start
    ' position tried, so with Global = True some matches may already have been found
    ' and returned before the search gave up.
    '
    ' PER INSTANCE, not per module. StaticRegex.StepsLimitHit is a module-level flag
    ' shared by every RegExp in the process, so reading it directly would let one
    ' object's abort show up on another - including on a brand new one that has not
    ' run anything yet. Each entry point therefore clears this field on the way in
    ' (before EnsureCompiled, so a raise on an invalid pattern also leaves it False:
    ' no search ran, so none was abandoned) and latches the engine flag into it on
    ' the way out. What a caller reads is then only ever about calls on THIS object.
    [Description("True if the most recent Test, Execute, Replace or Split on this object gave up before finishing its search. Results may be truncated or missing, and nothing is raised. In practice only a catastrophically backtracking pattern - nested quantifiers such as '(a+)+b' - can reach this.")]
    Public Property Get SearchAborted() As Boolean
        SearchAborted = mSearchAborted
    End Property
    '<<< PATCH 18

    ' Compiles the current Pattern once per Pattern/IgnoreCase change, trapping any engine
    ' error so validity can be queried without raising. Never raises. IgnoreCase is the only
    ' compile-time flag; MultiLine/DotAll/Global are applied at match time, so recompiling
    ' only on Pattern/IgnoreCase change is correct.
    '
    ' CacheCaptureInfo is inside the protected region deliberately: it reads bytecode that
    ' InitializeRegex just produced and should not throw, but letting it escape would break
    ' the documented "IsValid does not raise" contract. Inside, a bug there is merely
    ' misreported as an invalid pattern.
    Private Sub EnsureCompiled()
        If mCompileAttempted Then Exit Sub
        mCompileAttempted = True
        mLastErrNumber = 0
        mLastError = vbNullString

        On Error GoTo CompileFailed
        StaticRegex.InitializeRegex regex, mPattern, mIgnoreCase
        CacheCaptureInfo
        On Error GoTo 0
        mIsValid = True
        Exit Sub

CompileFailed:
        mLastErrNumber = Err.Number
        mLastError = ErrText(mLastErrNumber, Err.Description)
        mIsValid = False
        ' a failed compile leaves the PREVIOUS pattern's cache in place; every public
        ' entry point raises on Not mIsValid before touching it, so this keeps that true
        mNamedCount = 0
        mNumCaptures = 0
    End Sub

    ' Walks the bytecode identifier map once per compiled Pattern and caches the
    ' name -> identifier-id mapping as arrays. Replaces GetNamedCapturesInfo, which
    ' built two Collections on every Execute call for data that cannot change
    ' between calls. Also derives the numbered-capture count.
    '
    ' The identifier map is a red-black tree keyed by name, so mNamedCount is the
    ' number of DISTINCT names - a pattern with duplicate names has fewer entries
    ' here than it has named groups.
    Private Sub CacheCaptureInfo()
        Dim identifierMapEnd As Long
        Dim currentEntry As Long
        Dim k As Long

        mNamedCount = regex.bytecode(BYTECODE_IDX_N_IDENTIFIERS)

        ' Mirrors StaticRegex (DfsMatch):
        '   nProperCapturePoints = bytecode(0) + 1
        '   nNumberedCaptures    = nProperCapturePoints \ 2 - 1
        mNumCaptures = (regex.bytecode(BYTECODE_IDX_MAX_PROPER_CAPTURE_SLOT) + 1) \ 2 - 1
        If mNumCaptures < 0 Then mNumCaptures = 0

        If mNamedCount <= 0 Then
            mNamedCount = 0
            Erase mCapNames
            Erase mCapEntryPoints
            Exit Sub
        End If

        ReDim mCapNames(0 To mNamedCount - 1)
        ReDim mCapEntryPoints(0 To mNamedCount - 1)

        identifierMapEnd = BYTECODE_IDENTIFIER_MAP_BEGIN + _
            BYTECODE_IDENTIFIER_MAP_ENTRY_SIZE * mNamedCount
        currentEntry = BYTECODE_IDENTIFIER_MAP_BEGIN
        k = 0

        Do While currentEntry < identifierMapEnd
            mCapNames(k) = Mid$( _
                regex.pattern, _
                regex.bytecode(currentEntry + BYTECODE_IDENTIFIER_MAP_ENTRY_START_IN_PATTERN), _
                regex.bytecode(currentEntry + BYTECODE_IDENTIFIER_MAP_ENTRY_LENGTH_IN_PATTERN) _
            )
            mCapEntryPoints(k) = regex.bytecode(currentEntry + BYTECODE_IDENTIFIER_MAP_ENTRY_ID)
            k = k + 1
            currentEntry = currentEntry + BYTECODE_IDENTIFIER_MAP_ENTRY_SIZE
        Loop
    End Sub

    Private Sub Class_Initialize()
        mGlobal = False 'StaticRegex defaults to True
        mMultiLine = False
        mIgnoreCase = False
        mDotAll = False
    End Sub

    ' Maps an engine REGEX_ERR_* number to a human-readable description.
    ' Offsets mirror StaticRegex's error enum (REGEX_ERR = vbObjectError + 3000).
    Private Function DescribeRegexError(ByVal errNum As Long) As String
        Const BASE As Long = vbObjectError + 3000
        Select Case errNum - BASE
        Case 1   ' INVALID_REGEXP_ESCAPE
            DescribeRegexError = "Invalid escape sequence in the pattern (an unrecognized '\' escape)."
        Case 2   ' INVALID_ESCAPE
            DescribeRegexError = "Invalid escape sequence."
        Case 3   ' INVALID_RANGE
            DescribeRegexError = "Invalid character range in a '[...]' class (e.g. '[z-a]', where the start is greater than the end)."
        Case 4   ' UNTERMINATED_CHARCLASS
            DescribeRegexError = "Unterminated character class: a '[' without a matching ']'."
        Case 6   ' INVALID_REGEXP_GROUP
            DescribeRegexError = "Invalid group construct: a malformed '(?...)' group."
        Case 7   ' INVALID_REGEXP_CHARACTER
            DescribeRegexError = "Invalid character in the pattern."
        Case 8   ' INVALID_QUANTIFIER
            DescribeRegexError = "Invalid quantifier: a malformed '{n,m}' count (e.g. '{2,1}', or a number too large)."
        Case 9   ' UNEXPECTED_END_OF_PATTERN
            DescribeRegexError = "Unexpected end of pattern: an unclosed group — a '(' without a matching ')'."
        Case 10  ' UNEXPECTED_REGEXP_TOKEN
            DescribeRegexError = "Unexpected token in the pattern."
        Case 11  ' UNEXPECTED_CLOSING_PAREN
            DescribeRegexError = "Unmatched ')': a closing parenthesis with no matching '('."
        Case 12  ' INVALID_QUANTIFIER_NO_ATOM
            DescribeRegexError = "Quantifier with nothing to repeat (e.g. a leading '*', '+', or '?')."
        Case 13  ' INVALID_IDENTIFIER
            DescribeRegexError = "Invalid capture-group name. Names must start with a letter or underscore, then contain only letters, digits, or underscores (and must not start with a digit)."
        Case 14  ' INVALID_MODIFIER
            DescribeRegexError = "Invalid inline modifier: a malformed or repeated '(?i)'/'(?m)'/'(?s)' flag group."
        Case 20  ' INTERNAL_LOGIC_ERR
            DescribeRegexError = "Internal engine error (this should not happen — please report the pattern)."
        Case 30  ' INVALID_FLAG_ERR
            DescribeRegexError = "Invalid flag."
        Case 31  ' INVALID_REPLACEMENT_STRING
            DescribeRegexError = "Invalid replacement string (a malformed '$' reference)."
        Case 50  ' INVALID_INPUT
            DescribeRegexError = "Invalid input."
        Case Else
            ' not one of ours - pass through whatever the runtime gave us, or a generic line
            DescribeRegexError = vbNullString
        End Select
    End Function

    Private Function ErrText(ByVal errNum As Long, ByVal fallback As String) As String
        Dim s As String
        s = DescribeRegexError(errNum)
        If LenB(s) = 0 Then
            If LenB(fallback) > 0 Then ErrText = fallback Else ErrText = "Invalid regular expression pattern."
        Else
            ErrText = s
        End If
    End Function

End Class

[PredeclaredId(False)]
[Hidden(False)]
[Description("This class represents the results from a single regular expression match.")]
Public Class Match
    Option Explicit

    Private oSubMatches As SubMatches
    Private mValue As String
    Private mFirstIndex As Long
    Private mLength As Long

    [Description("Returns the SubMatches collection of submatch (Group) strings.")]
    Public Property Get SubMatches() As SubMatches
        ' group-less matches share one empty instance (no per-match allocation)
        If oSubMatches Is Nothing Then
            Set SubMatches = modRegexShared.EmptySubMatches
        Else
            Set SubMatches = oSubMatches
        End If
    End Property

    [Description("Returns the entire matched string")]
    [DefaultMember]
    Public Property Get Value() As String
        Value = mValue
    End Property

    [Description("Returns the character index position associated with the start of the match string. Note that the index is zero-based.")]
    Public Property Get FirstIndex() As Long
        FirstIndex = mFirstIndex
    End Property

    [Description("Returns the character length of the match string.")]
    Public Property Get Length() As Long
        Length = mLength
    End Property

    ' Internal_ prefix: package-internal construction seam. tB leaks Friend across the
    ' package boundary, so this flags it as not-for-consumers. Single channel for building
    ' a Match: scalars in one shot, submatches moved in as arrays. subCount = 0 keeps the
    ' shared-empty SubMatches (group-less fast path).
    Friend Sub Internal_Init(ByVal matchValue As String, ByVal firstIndex As Long, ByVal length As Long, _
                             ByRef subVals() As String, ByRef subKeys() As String, ByVal subCount As Long)
        mValue = matchValue
        mFirstIndex = firstIndex
        mLength = length
        If subCount > 0 Then
            Set oSubMatches = New SubMatches
            oSubMatches.Internal_SetData subVals, subKeys, subCount
        End If
    End Sub

    Private Sub Class_Terminate()
        Set oSubMatches = Nothing
    End Sub

End Class

[PredeclaredId(False)]
[Hidden(False)]
[Description("This class represents a collection of match objects.")]
Public Class MatchCollection
    Option Explicit

    ' PHASE 2: array-backed storage. A Collection costs ~12us to create and
    ' destroy, and Class_Initialize paid it on every Execute call whether or not
    ' anything matched.
    ' PHASE 3: the lazy enumeration Collection is gone too - For Each now gets a
    ' real IEnumVARIANT (MatchCollectionEnum) reading mItems in place. Cheaper
    ' here than for SubMatches (one Collection per enumeration, not per match),
    ' but it matters most for the common small result set, where a 12us
    ' allocation dwarfs a ~3us Execute.
    Private mItems() As Match
    Private mCount As Long
    Private mCap As Long

    Friend Sub Internal_Add(obj As Match)
        If mCount = mCap Then
            If mCap = 0 Then mCap = 8 Else mCap = mCap * 2
            ReDim Preserve mItems(0 To mCap - 1)
        End If
        Set mItems(mCount) = obj
        mCount = mCount + 1
    End Sub

    ' Read seam for MatchCollectionEnum, so the enumerator copies nothing and
    ' skips Item's Variant arithmetic.
    Friend Function Internal_ItemAt(ByVal pIndex As Long) As Match
        Set Internal_ItemAt = mItems(pIndex)
    End Function

    [Description("Returns the number of Match objects found in the source string.")]
    Public Property Get Count() As Long
       Count = mCount
    End Property

    [Description("Returns the Match object associated with the provided index")]
    [DefaultMember]
    Public Property Get Item(ByVal pItemIndex As Variant) As Match
        'VBS is zero-based. The Variant arithmetic below is kept exactly as it was,
        'so out-of-range and wrong-type behaviour is unchanged by the move to array
        'storage.
        If pItemIndex + 1 >= 1 And pItemIndex + 1 <= mCount Then
            Set Item = mItems(CLng(pItemIndex))
        Else
            Err.Raise(vbObjectError + 9, , "Requested item not found in Matches collection")
        End If
    End Property

    [Hidden]
    [Enumerator]
    Public Function NewEnum() As IUnknown
        Dim e As MatchCollectionEnum
        Set e = New MatchCollectionEnum
        e.Attach Me, 0
        Set NewEnum = e
    End Function

    Private Sub Class_Terminate()
        Erase mItems
    End Sub

End Class

[PredeclaredId(False)]
[Hidden(False)]
[Description("This class provides the means to access SubMatch (Group) values.")]
Public Class SubMatches
    Option Explicit

    ' Array-backed storage. PHASE 3: the lazy enumeration Collection is gone -
    ' For Each now gets a real IEnumVARIANT (SubMatchesEnum) that reads mVals in
    ' place. That Collection was allocated ONCE PER MATCH, and measured at ~112us
    ' per match against ~4us for index access: a 28x penalty on idiomatic
    ' For Each code. It was the last per-match allocation in the library.
    Private mVals() As String
    Private mKeys() As String       ' parallel to mVals; vbNullString for unnamed groups
    Private mCount As Long
    Private mCap As Long

    ' Internal_ prefix: package-internal seam (tB leaks Friend across the package boundary).
    ' Bulk-assign the backing arrays in one operation instead of N Add calls. Note that
    ' array assignment COPIES in tB/VBA, so this instance owns its own data and can never
    ' alias a caller's scratch buffer.
    '
    ' WRITE-ONCE. Match.Internal_Init calls this exactly once, at construction, and
    ' nothing else mutates a SubMatches afterwards. SubMatchesEnum relies on that:
    ' it captures Count at Attach time and reads mVals live. If a mutation path is
    ' ever added here, the enumerator needs a generation counter, the way Cells does.
    Friend Sub Internal_SetData(ByRef vals() As String, ByRef keys() As String, ByVal count As Long)
        mVals = vals            ' single bulk array assignment
        mKeys = keys
        mCount = count
        mCap = count            ' arrays are sized exactly; growth path unused here
    End Sub

    ' Read seam for SubMatchesEnum, so the enumerator copies nothing.
    Friend Function Internal_ValueAt(ByVal pIndex As Long) As String
        Internal_ValueAt = mVals(pIndex)
    End Function

    [Description("Returns the number of SubMatch objects found in the source string.")]
    Public Property Get Count() As Long
        Count = mCount
    End Property

    [Description("Returns the SubMatch string associated with the provided index. Named groups are allowed.")]
    [DefaultMember]
    Public Property Get Item(ByVal pItemIndex As Variant) As String
        If Not IsNumeric(pItemIndex) Then
            'lookup by name; not-found or empty-value both yield vbNullString (prior behavior)
            Dim i As Long
            For i = 0 To mCount - 1
                If mKeys(i) = pItemIndex Then
                    Item = mVals(i)
                    Exit Property
                End If
            Next i
        Else
            'VBS is zero-based
            If pItemIndex >= 0 And pItemIndex < mCount Then
                Item = mVals(pItemIndex)
            Else
                Err.Raise(vbObjectError + 9, , "Requested item not found in SubMatches collection")
            End If
        End If
    End Property

    [Hidden]
    [Enumerator]
    Public Function NewEnum() As IUnknown
        Dim e As SubMatchesEnum
        Set e = New SubMatchesEnum
        e.Attach Me, 0
        Set NewEnum = e
    End Function

End Class

Private Module modRegexShared
    Option Explicit
    ' One read-only, always-empty SubMatches shared by every match of a group-less
    ' pattern, so those matches don't each allocate a SubMatches + Collection.
    ' Safe to share: it is never Added to (Add is Friend and never called on it),
    ' so it stays empty and immutable — observationally identical to a fresh empty.

    Private mEmpty As SubMatches

    Public Function EmptySubMatches() As SubMatches
        If mEmpty Is Nothing Then Set mEmpty = New SubMatches
        Set EmptySubMatches = mEmpty
    End Function
End Module

' ==========================================================================
'  IEnumVARIANT - For Each support without a throwaway Collection
'
'  Modelled on the CellsEnum pattern, which paid for the three traps already:
'
'   - Declared here, not taken from stdole. stdole's IEnumVARIANT counts items
'     in unsigned 32-bit integers and twinBASIC has no unsigned 32-bit type, so
'     the compiler reports {unsupported VT_UI4} and no handler can match. Same
'     interface identifier with Long counts; QueryInterface matches on the
'     identifier, so a caller asking for the real IEnumVARIANT gets this.
'
'   - For Each ends the loop ONLY on S_FALSE. It passes a NULL pointer for
'     pCeltFetched and never reads it. A Next that returns S_OK having written
'     nothing loops forever, so the address is tested before anything is
'     written through it, and the end of the sequence is Err.ReturnHResult.
'
'   - An item written on a call that returns S_FALSE is DROPPED. The call that
'     writes the LAST item must return S_OK; the call after it returns S_FALSE
'     having written nothing. Doing both at once silently loses one item.
'
'  [PreserveSig] cannot be implemented as of BETA 1005, so the HRESULT comes
'  back via Err.ReturnHResult rather than as a function result. Next and Reset
'  are spelled bare despite reading like keywords, as the documented example
'  does. Asking for more than one item returns one, which is legal as long as
'  S_FALSE goes with it; this form of the declaration names only the first
'  element of the caller's array, and nothing here wants a bulk path.
'
'  Neither enumerator carries a generation counter, because neither source can
'  change once the caller can see it: SubMatches is written once by
'  Match.Internal_Init, and a MatchCollection is fully populated before Execute
'  returns it. Add a mutation path to either and they will need one.
' ==========================================================================
[InterfaceId("00020404-0000-0000-C000-000000000046")]
Private Interface IEnumVARIANT Extends stdole.IUnknown
    Sub Next(ByVal celt As Long, ByRef rgVar As Variant, ByRef pCeltFetched As Long)
    Sub Skip(ByVal celt As Long)
    Sub Reset()
    Function Clone() As IEnumVARIANT
End Interface

[PredeclaredId(False)]
[Hidden(True)]
Private Class SubMatchesEnum
    Option Explicit

    Implements IEnumVARIANT

    Private Const S_FALSE As Long = 1

    Private mSrc As SubMatches
    Private mCount As Long           ' captured at Attach; SubMatches is write-once
    Private mPos As Long             ' how many handed out, so 0 means at the start

    ' ByVal, not ByRef: SubMatches.NewEnum passes Me, which is not an lvalue.
    Friend Sub Attach(ByVal src As SubMatches, ByVal startPos As Long)
        Set mSrc = src
        mCount = src.Count
        mPos = startPos
    End Sub

    Private Sub Class_Terminate()
        Set mSrc = Nothing
    End Sub

    Private Sub Next(ByVal celt As Long, ByRef rgVar As Variant, _
                     ByRef pCeltFetched As Long) Implements IEnumVARIANT.Next
        Dim n As Long
        If celt > 0 Then
            If mPos < mCount Then
                mPos = mPos + 1
                ' Let, not Set: submatches are Strings, not objects.
                rgVar = mSrc.Internal_ValueAt(mPos - 1)
                n = 1
            End If
        End If
        If VarPtr(pCeltFetched) <> 0 Then pCeltFetched = n
        If n < celt Then Err.ReturnHResult = S_FALSE
    End Sub

    Private Sub Skip(ByVal celt As Long) Implements IEnumVARIANT.Skip
        Dim room As Long
        If celt <= 0 Then Exit Sub
        room = mCount - mPos
        If room >= celt Then
            mPos = mPos + celt
        Else
            mPos = mCount
            Err.ReturnHResult = S_FALSE
        End If
    End Sub

    Private Sub Reset() Implements IEnumVARIANT.Reset
        mPos = 0
    End Sub

    Private Function Clone() As IEnumVARIANT Implements IEnumVARIANT.Clone
        Dim e As SubMatchesEnum
        Set e = New SubMatchesEnum
        e.Attach mSrc, mPos
        Set Clone = e
    End Function

End Class

[PredeclaredId(False)]
[Hidden(True)]
Private Class MatchCollectionEnum
    Option Explicit

    Implements IEnumVARIANT

    Private Const S_FALSE As Long = 1

    Private mSrc As MatchCollection
    Private mCount As Long           ' captured at Attach; fully populated by then
    Private mPos As Long

    Friend Sub Attach(ByVal src As MatchCollection, ByVal startPos As Long)
        Set mSrc = src
        mCount = src.Count
        mPos = startPos
    End Sub

    Private Sub Class_Terminate()
        Set mSrc = Nothing
    End Sub

    Private Sub Next(ByVal celt As Long, ByRef rgVar As Variant, _
                     ByRef pCeltFetched As Long) Implements IEnumVARIANT.Next
        Dim n As Long
        If celt > 0 Then
            If mPos < mCount Then
                mPos = mPos + 1
                ' Set, not Let: matches are objects.
                Set rgVar = mSrc.Internal_ItemAt(mPos - 1)
                n = 1
            End If
        End If
        If VarPtr(pCeltFetched) <> 0 Then pCeltFetched = n
        If n < celt Then Err.ReturnHResult = S_FALSE
    End Sub

    Private Sub Skip(ByVal celt As Long) Implements IEnumVARIANT.Skip
        Dim room As Long
        If celt <= 0 Then Exit Sub
        room = mCount - mPos
        If room >= celt Then
            mPos = mPos + celt
        Else
            mPos = mCount
            Err.ReturnHResult = S_FALSE
        End If
    End Sub

    Private Sub Reset() Implements IEnumVARIANT.Reset
        mPos = 0
    End Sub

    Private Function Clone() As IEnumVARIANT Implements IEnumVARIANT.Clone
        Dim e As MatchCollectionEnum
        Set e = New MatchCollectionEnum
        e.Attach mSrc, mPos
        Set Clone = e
    End Function

End Class
